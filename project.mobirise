        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            ".mbr-text": {
              "color": "#000000"
            },
            ".media-container-row .mbr-text": {
              "color": "#d8d0ca"
            }
          },
          "_name": "afooter2",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer2 orderm5\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#2d2d2d\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#F5FF7D\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row align-center\">\n            <div class=\"col-12\">\n                <p class=\"mbr-text mb-0 mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".media-container-row .mbr-text\" data-app-placeholder=\"Type Text\">\n                    © Copyright 2025 <a href=\"http://lemmaiot.com.ng\" class=\"text-primary\" target=\"_blank\"><b>LemmaIoT </b></a>- All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uOmybejsuF",
          "_anchor": "footer",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "our-terms.html": {
      "settings": {
        "title": "Terms and Conditions for MyCV.i.ng",
        "order": "5",
        "meta_descr": "Welcome to MyCV.i.ng, a service provided to help individuals convert their traditional CVs into personalized websites hosted under our platform (e.g. www.mycv.i.ng/yourname). By using this service, you agree to the following terms and conditions:"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-title": {
              "color": "#2d2d2d"
            },
            ".title-container": {
              "display": "flex",
              "align-items": "center",
              "@media (max-width: 1199px)": {
                "flex-wrap": "wrap"
              }
            },
            ".title-container-1": {
              "display": "block"
            },
            ".iconfont-wrapper": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "background-color": "@iconBgColor",
              "padding": "36px",
              "border-radius": "16px",
              "margin-right": "20px",
              "margin-bottom": "20px",
              "margin-top": "20px",
              "float": "left",
              "& when (@iconBorder)": {
                "border": "1px solid @iconBorderColor"
              },
              "@media (max-width: 991px)": {
                "display": "none"
              },
              ".mbr-iconfont": {
                "color": "@iconColor",
                "font-size": "54px"
              }
            },
            ".mbr-section-subtitle-1": {
              "color": "#4a90e2",
              "text-shadow": "2px 0 0 @subtitle1Color, 0 2px 0 @subtitle1Color, -2px 0 0 @subtitle1Color, 0 -2px 0 @subtitle1Color",
              "@media (max-width: 991px)": {
                "color": "@subtitle1Color",
                "text-shadow": "none"
              }
            },
            ".mbr-section-subtitle-2": {
              "color": "#000000",
              "@media (max-width: 1199px)": {
                "width": "100%"
              }
            },
            ".mbr-section-btn": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "center",
              "@media (min-width: 1200px)": {
                "margin": "0 10px",
                "min-width": "30%",
                "flex-grow": "1",
                ".btn": {
                  "padding": "2.3vw 4.8vw"
                }
              },
              "@media (max-width: 1199px)": {
                "margin-top": "10px"
              },
              "@media (max-width: 575px)": {
                "align-items": "stretch"
              }
            },
            ".mbr-text": {
              "color": "#000000",
              "margin-top": "5.14vw",
              "margin-left": "7.64vw",
              "width": "30.56vw",
              "margin-right": "auto",
              "@media (max-width: 991px)": {
                "margin-top": "6.7vw",
                "margin-left": "0",
                "margin-right": "0",
                "width": "100%"
              },
              "@media (max-width: 767px)": {
                "margin-top": "10.67vw"
              }
            },
            ".mbr-section-subtitle-2, .mbr-section-btn": {
              "color": "#2d2d2d"
            }
          },
          "_name": "aheader1",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header1 orderm5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"4\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\" condition=\"fullScreen == false\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#000000\" selected condition=\"showIcon\">\n        <input type=\"color\" title=\"Icon BG Color\" name=\"iconBgColor\" value=\"#F37C6C\" selected condition=\"showIcon\">\n        <input type=\"checkbox\" title=\"Icons Border\" name=\"iconBorder\" checked condition=\"showIcon\">\n        <input type=\"color\" title=\"Icon Border Color\" name=\"iconBorderColor\" value=\"#000000\" selected condition=\"showIcon && iconBorder\">\n        <input type=\"checkbox\" title=\"Subtitle 1\" name=\"showSubtitle1\" checked>\n        <input type=\"color\" title=\"Subtitle 1 Color\" name=\"subtitle1Color\" value=\"#000000\" selected condition=\"showSubtitle1\">\n        <input type=\"checkbox\" title=\"Subtitle 2\" name=\"showSubtitle2\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\" selected>\n            <input type=\"color\" title=\"Color\" value=\"#ede7e2\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#dfe8ff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"row\">\n            <div class=\"col-12\">\n                <h1 class=\"mbr-section-title mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Terms and Conditions</h1>\n                <div class=\"title-container title-container-1\" mbr-if=\"showIcon || showSubtitle1\">\n                    <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                        <a href=\"out-terms.html#aarticle1-5\"><span mbr-icon class=\"mbr-iconfont mobi-mbri-down mobi-mbri\"></span></a>\n                    </div>\n                    <h2 class=\"mbr-section-subtitle-1 mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-subtitle-1\" mbr-theme-style=\"display-1\" mbr-if=\"showSubtitle1\">\n                        MyCV.i.ng\n                    </h2>\n                </div>\n                <div class=\"title-container title-container-2\" mbr-if=\"showButtons || showSubtitle2\">\n                    <h2 class=\"mbr-section-subtitle-2 mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-subtitle-2, .mbr-section-btn\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle2\">Last Updated: 16th June, 2025</h2>\n                    <div mbr-buttons mbr-theme-style=\"display-5\" class=\"mbr-section-btn custom-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-iconFont\">\n                        <a class=\"btn btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            <div class=\"btn-transform\">GET STARTED</div>\n                        </a>\n                    </div>\n                </div>\n                <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text\">\n                    Welcome to MyCV.i.ng, a service provided to help individuals convert their traditional CVs into personalized websites hosted under our platform (e.g. www.mycv.i.ng/yourname). By using this service, you agree to the following terms and conditions:\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uOkjLJZwpT",
          "_anchor": "aheader",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "position": "relative",
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".second-bg-color": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "background-color": "@secondColor",
              "border-top-left-radius": "4.1666666667vw",
              "border-top-right-radius": "4.1666666667vw"
            },
            ".mbr-section-title": {
              "color": "#000000",
              "margin-bottom": "1.736vw",
              "@media (max-width: 991px)": {
                "margin-bottom": "6.66vw"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#2d2d2d",
              "margin-bottom": "1.736vw",
              "@media (max-width: 991px)": {
                "margin-bottom": "6.66vw"
