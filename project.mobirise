          "_name": "afeatures4",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features2 orderm5\" group=\"Features\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" name=\"showLabel\" title=\"Label\">\n        <input type=\"checkbox\" name=\"showTitle1\" title=\"Title 1\" checked>\n        <input type=\"checkbox\" name=\"showTitle2\" title=\"Title 2\">\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#000000\" selected condition=\"showIcon\">\n        <input type=\"color\" title=\"Icon BG Color\" name=\"iconBgColor\" value=\"#C5D4FE\" selected condition=\"showIcon\">\n        <input type=\"checkbox\" title=\"Icons Border\" name=\"iconBorder\" condition=\"showIcon\">\n        <input type=\"color\" title=\"Icon Border Color\" name=\"iconBorderColor\" value=\"#000000\" selected condition=\"showIcon && iconBorder\">\n        <input type=\"checkbox\" name=\"showSubtitle\" title=\"Subtitle\">\n        <header>Cards</header>\n        <input type=\"range\" inline title=\"Count\" name=\"cardCount\" min=\"1\" max=\"6\" step=\"1\" value=\"2\">\n        <input type=\"color\" title=\"Icon Color\" name=\"iconCardColor\" value=\"#000000\" selected>\n        <input type=\"color\" title=\"Icon BG Color\" name=\"iconCardBgColor\" value=\"#dfe8ff\" selected>\n        <input type=\"checkbox\" name=\"showCardTitle\" title=\"Title\" checked>\n        <input type=\"checkbox\" name=\"showText\" title=\"Text\" checked>\n        <input type=\"checkbox\" name=\"showButtons\" title=\"Buttons\">\n        <input type=\"checkbox\" name=\"cardBg\" title=\"Card BG\" checked>\n        <input type=\"color\" name=\"cardsBgColor\" title=\"Card BG Color\" value=\"#dfe8ff\" condition=\"cardBg\">\n        <input type=\"checkbox\" name=\"cardBorder\" title=\"Card Border\" checked>\n        <input type=\"color\" name=\"cardBorderColor\" title=\"Card Border Color\" value=\"#2d2d2d\" condition=\"cardBorder\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#dfe8ff\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Second Bg Color\" name=\"secondBgColor\" condition=\"bg.type === 'color'\" checked>\n        <input type=\"color\" title=\"Second Color\" name=\"secondColor\" value=\"#2d2d2d\" condition=\"secondBgColor && bg.type === 'color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type == 'image'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.1\" condition=\"overlay && bg.type == 'image'\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\"></div>\n    <div class=\"second-bg-color\" mbr-if=\"secondBgColor\"></div>\n    <div class=\"container\">\n        <div class=\"mbr-section-head\" mbr-if=\"showLabel || showTitle1 || showTitle2 || showIcon || showSubtitle\">\n            <p class=\"label-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLabel\" data-app-selector=\".label-text\">\n                Tempor orci\n            </p>\n            <h4 class=\"mbr-section-title mbr-section-title-1 mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle1\" data-app-selector=\".mbr-section-title-1\">Visual Comparison Section</h4>\n            <div class=\"section-head-container\" mbr-if=\"showTitle2 || showIcon || showSubtitle\">\n                <h4 class=\"mbr-section-title mbr-section-title-2 mbr-fonts-style mb-0\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle2\" data-app-selector=\".mbr-section-title-2\">\n                    MAIL\n                </h4>\n                <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                    <span mbr-icon class=\"mbr-iconfont mobi-mbri-letter mobi-mbri\"></span>\n                </div>\n                <h5 class=\"mbr-section-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                    Eget lorem dolor  sed viverra ipsum elit scelerisque mauris. Sit amet venenatis urna cursus eget.\n                </h5>\n            </div>\n        </div>\n\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"item col-12 col-md-6 col-lg-4\">\n                <div class=\"item-wrap\">\n                    <div class=\"item-head\">\n                        <div class=\"item-img\">\n                            <span mbr-icon class=\"mbr-iconfont imind-newspaper\"></span>\n                        </div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>Traditional CVs Feel Outdated</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-2\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                            A standard PDF or Word CV often gets buried in crowded inboxes, opens awkwardly on mobile devices, and lacks the visual appeal needed to leave a strong first impression. It’s static, hard to personalize, and doesn’t reflect your modern, professional self.<br>\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn custom-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-iconFont, -mbrBtnMove, -mbrBtnAdd\">\n                            <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <div class=\"btn-transform\">READ MORE</div>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"item col-12 col-md-6 col-lg-4\" mbr-if=\"cardCount > 1\">\n                <div class=\"item-wrap\">\n                    <div class=\"item-head\">\n                        <div class=\"item-img\">\n                            <span mbr-icon class=\"mbr-iconfont mbri-website-theme\"></span>\n                        </div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-4\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\"><b>MyCV.i.ng Makes You Stand Out</b></h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-2\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                            With MyCV.i.ng, your resume becomes a sleek personal website that’s easy to access, mobile-optimized, and designed to impress. You get your own shareable link, a professional layout, and a fresh digital presence — all without lifting a finger.</p>\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn custom-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-iconFont, -mbrBtnMove, -mbrBtnAdd\">\n                            <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <div class=\"btn-transform\">READ MORE</div>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item col-12 col-md-6 col-lg-4\" mbr-if=\"cardCount > 2\">\n                <div class=\"item-wrap\">\n                    <div class=\"item-head\">\n                        <div class=\"item-img\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-rocket mobi-mbri\"></span>\n                        </div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            DUI SAPIEN\n                        </h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-2\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                            Volutpat odio facilisis mauris sit amet massa vitae. Ac tortor vitae purus faucibus\n                            ornare suspendisse sed.\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn custom-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-iconFont, -mbrBtnMove, -mbrBtnAdd\">\n                            <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <div class=\"btn-transform\">READ MORE</div>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item col-12 col-md-6 col-lg-4\" mbr-if=\"cardCount > 3\">\n                <div class=\"item-wrap\">\n                    <div class=\"item-head\">\n                        <div class=\"item-img\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-hearth mobi-mbri\"></span>\n                        </div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            FEUGIAT NIBH\n                        </h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-2\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                            Bibendum arcu vitae elementum curabitur vitae nunc. Ac orci phasellus egestas\n                            tellus rutrum tellus.\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn custom-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-iconFont, -mbrBtnMove, -mbrBtnAdd\">\n                            <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <div class=\"btn-transform\">READ MORE</div>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item col-12 col-md-6 col-lg-4\" mbr-if=\"cardCount > 4\">\n                <div class=\"item-wrap\">\n                    <div class=\"item-head\">\n                        <div class=\"item-img\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-rocket mobi-mbri\"></span>\n                        </div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            DUI SAPIEN\n                        </h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-2\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                            Volutpat odio facilisis mauris sit amet massa vitae. Ac tortor vitae purus faucibus\n                            ornare suspendisse sed.\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn custom-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-iconFont, -mbrBtnMove, -mbrBtnAdd\">\n                            <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <div class=\"btn-transform\">READ MORE</div>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"item col-12 col-md-6 col-lg-4\" mbr-if=\"cardCount > 5\">\n                <div class=\"item-wrap\">\n                    <div class=\"item-head\">\n                        <div class=\"item-img\">\n                            <span mbr-icon class=\"mbr-iconfont mobi-mbri-rocket mobi-mbri\"></span>\n                        </div>\n                    </div>\n                    <div class=\"item-content\" mbr-if=\"showCardTitle || showText || showButtons\">\n                        <h5 class=\"item-title mbr-fonts-style\" mbr-theme-style=\"display-5\" data-app-selector=\".item-title\" mbr-if=\"showCardTitle\">\n                            DUI SAPIEN\n                        </h5>\n                        <p class=\"mbr-text mbr-fonts-style mb-2\" mbr-if=\"showText\" mbr-theme-style=\"display-7\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                            Volutpat odio facilisis mauris sit amet massa vitae. Ac tortor vitae purus faucibus\n                            ornare suspendisse sed.\n                        </p>\n                        <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn custom-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-iconFont, -mbrBtnMove, -mbrBtnAdd\">\n                            <a class=\"btn btn-black\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                                <div class=\"btn-transform\">READ MORE</div>\n                            </a>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_cid": "tlJRiPWqcD",
          "_anchor": "compare",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "position": "relative",
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".second-bg-color": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "background-color": "@secondColor",
              "border-top-left-radius": "4.1666666667vw",
              "border-top-right-radius": "4.1666666667vw"
            },
            ".mbr-section-title": {
              "color": "#000000",
              "margin-bottom": "1.736vw",
              "@media (max-width: 991px)": {
                "margin-bottom": "6.66vw"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#2d2d2d",
              "margin-bottom": "1.736vw",
              "@media (max-width: 991px)": {
                "margin-bottom": "6.66vw"
              }
            },
            ".mbr-text": {
              "color": "#000000"
            }
          },
          "_name": "aarticle1",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article1 orderm5\" group=\"Article\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"8\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#2d2d2d\">\n        <input type=\"checkbox\" title=\"Second Bg Color\" name=\"secondBgColor\" checked>\n        <input type=\"color\" title=\"Second Color\" name=\"secondColor\" value=\"#dfe8ff\" condition=\"secondBgColor\">\n    </mbr-parameters>\n    <div class=\"second-bg-color\" mbr-if=\"secondBgColor\"></div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\">\n                    PROIN LIBERO\n                </h3>\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\"><b>Your Career. Your Website. One Click Away.</b></h4>\n                <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-4\">In a world where first impressions happen online, handing out static PDF resumes just doesn’t cut it anymore. Recruiters, clients, and collaborators expect more — and MyCV.i.ng delivers it.<br><br>Instead of blending in with a pile of documents, you stand out with a personalized website that’s clean, clickable, and built for modern screens. There’s no complicated setup, no design stress — just a fast, affordable solution that instantly levels up your personal brand.<br><br>It’s more than a CV. It’s your digital front door.</p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tlJSjLv9tX",
          "_anchor": "aarticle",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value",
              ".second-bg-color": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background-color": "@secondColor",
                "border-top-left-radius": "4.1666666667vw",
                "border-top-right-radius": "4.1666666667vw"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "position": "relative",
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".col-title": {
              "@media (max-width: 991px)": {
                "margin-bottom": "7vw"
              },
              "@media (max-width: 767px)": {
                "margin-bottom": "9vw"
              }
            },
            ".mbr-section-title": {
              "color": "#dfe8ff",
              "margin-bottom": "1rem"
            },
            ".mbr-section-subtitle": {
              "color": "#FFFFFF",
              "margin-bottom": "0"
            },
            ".toggle-panel": {
              "& when (@showListBorder)": {
                "border-top": "1px solid @listBorderColor"
              }
            },
            ".card": {
              "padding-bottom": "0",
              "border-radius": "0",
              "& when (@showListBorder)": {
                "border-bottom": "1px solid @listBorderColor"
              }
            },
            ".card-header": {
              "background-color": "transparent",
              "margin-bottom": "0",
              "padding": "0",
              "border-bottom": "none !important"
            },
            ".sign": {
              "font-family": "'Moririse2' !important",
              "padding": "10px",
              "font-size": "18px",
              "border-radius": "50%",
              "color": "@listIconColor",
              "border": "1px solid @listIconColor",
              "transition": "0.3s all",
              "animation": "icon-move-out 0.2s ease-out",
              "@media (max-width: 991px)": {
                "display": "flex",
                "align-items": "center",
                "justify-content": "center",
                "flex-shrink": "0",
                "padding": "0",
                "width": "7.3vw",
                "font-size": "3.7vw",
                "aspect-ratio": "(1 / 1)"
              },
              "@media (max-width: 767px)": {
                "width": "8.53vw",
                "font-size": "4.3vw"
              }
            },
            ".panel-title-edit": {
              "color": "#dfe8ff",
              "padding-right": "1rem",
              "transition": ".3s all"
            },
            ".panel-title": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding": "36px 0",
              "transition": ".4s all",
              "@media (max-width: 991px)": {
                "padding": "5vw 0"
              },
              "@media (max-width: 767px)": {
                "padding": "6.4vw 0"
              },
              "&[aria-expanded=\"false\"]": {
                ".sign": {
                  "&:hover": {
                    "animation": "icon-move 0.8s forwards"
                  }
                }
              },
              "&[aria-expanded=\"true\"]": {
                ".sign": {
                  "transform": "rotate(135deg)"
                }
              }
            },
            ".panel-text": {
              "color": "#f9f7ff",
              "margin-bottom": "36px",
              "max-width": "80%",
              "width": "100%",
              "@media (max-width: 991px)": {
                "margin-bottom": "5vw",
                "max-width": "100%"
              },
              "@media (max-width: 767px)": {
                "margin-bottom": "6.4vw"
              }
            },
            "@keyframes icon-move": {
              "0%": {
                "transform": "translate3d(0, 0%, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg)",
                "will-change": "transform"
              },
              "80%": {
                "transform": "translate3d(0, 0%, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(360deg) skew(0deg, 0deg)"
              },
              "100%": {
                "transform": "translate3d(0, 0%, 0px) scale3d(1.2, 1.2, 1) rotateX(0deg) rotateY(0deg) rotateZ(360deg) skew(0deg, 0deg)",
                "will-change": "auto"
              }
            },
            "@keyframes icon-move-out": {
              "0%": {
                "transform": "translate3d(0, 0%, 0px) scale3d(1.2, 1.2, 1) rotateX(0deg) rotateY(0deg) rotateZ(0) skew(0deg, 0deg)",
                "will-change": "transform"
              },
              "100%": {
                "transform": "translate3d(0, 0%, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0) skew(0deg, 0deg)",
                "will-change": "auto"
              }
            }
          },
          "_name": "alist2",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list2 orderm5\" group=\"List\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-switch-arrow, mobirise-icons2\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"List Width\" name=\"textWidth\" min=\"5\" max=\"8\" step=\"1\" value=\"6\">\n        <input type=\"checkbox\" name=\"reverseContent\" title=\"Reverse\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <header>List</header>\n        <input type=\"checkbox\" title=\"Border\" name=\"showListBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"listBorderColor\" value=\"#232323\" condition=\"showListBorder\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showListIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"listIconColor\" value=\"#FFFFFF\" condition=\"showListIcon\">\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\" selected>6</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#dfe8ff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Second Bg Color\" name=\"secondBgColor\" condition=\"bg.type === 'color'\" checked>\n        <input type=\"color\" title=\"Second Color\" name=\"secondColor\" value=\"#2d2d2d\" condition=\"secondBgColor && bg.type === 'color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ede7e2\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"second-bg-color\" mbr-if=\"secondBgColor\"></div>\n    <div class=\"container\">\n            <div class=\"row justify-content-center\">\n                <div class=\"col-12 col-lg col-title\" mbr-if=\"showTitle || showSubtitle\">\n                    <h5 class=\"mbr-section-title mbr-fonts-style\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\">\n                        HAVE QUESTIONS?\n                    </h5>\n                    <h6 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-4\">Need more details?<br><br><div>Check out our <a href=\"our-terms.html#overview\" class=\"text-primary\" target=\"_blank\">Terms &amp; Conditions</a> and <a href=\"privacy.html#info\" class=\"text-primary\" target=\"_blank\">Privacy Policy</a> for full information on how we work, your rights, and how your data is handled.</div></h6>\n                </div>\n\n                <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                    <div id=\"bootstrap-toggle\" class=\"toggle-panel accordionStyles tab-content\">\n                        <div class=\"card mb-0\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"false\" aria-controls=\"collapse1\">\n                                    <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">How does MyCV.i.ng work?</h6>\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus\" mbr-if=\"showListIcon\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse1\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                        It’s simple! You just upload your CV (in PDF or Word format), make a one-time payment of ₦2,500, and send us your payment receipt. Within 24 hours, we’ll build your personal CV website and send you a link like www.mycv.i.ng/yourname.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-0\" mbr-if=\"cardAmount > 1\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingTwo\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                                    <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Do I need to design or build anything?</h6>\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus\" mbr-if=\"showListIcon\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingTwo\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                        Nope! You don’t need to touch a thing. We handle everything — the design, layout, and hosting. Just submit your CV and you’re good to go.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-0\" mbr-if=\"cardAmount > 2\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingThree\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                                    <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Can I submit a sample or preferred style?</h6>\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus\" mbr-if=\"showListIcon\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingThree\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                        Yes! You can send a link to a sample website you like, and we’ll do our best to follow that structure or feel. It’s totally optional, though — we’ll still make it look clean and professional.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-0\" mbr-if=\"cardAmount > 3\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingFour\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                                    <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">What do I get for ₦2,500?</h6>\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus\" mbr-if=\"showListIcon\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFour\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                        You get a fully hosted personal website version of your CV with your own custom link. There are no hidden charges, subscriptions, or extra fees. Just a one-time payment for a fully done-for-you service.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-0\" mbr-if=\"cardAmount > 4\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingFive\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse5\" aria-expanded=\"false\" aria-controls=\"collapse5\">\n                                    <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">How long does it take?</h6>\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus\" mbr-if=\"showListIcon\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse5\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingFive\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                        Your CV website will be live within 24 hours after we receive your CV and payment receipt. Quick, simple, and efficient.\n                                    </p>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"card mb-0\" mbr-if=\"cardAmount > 5\">\n                            <div class=\"card-header\" role=\"tab\" id=\"headingSix\">\n                                <a role=\"button\" class=\"collapsed panel-title text-black\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse6\" aria-expanded=\"false\" aria-controls=\"collapse6\">\n                                    <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\">Can I make changes after it goes live?</h6>\n                                    <span class=\"sign mbr-iconfont mobi-mbri-plus\" mbr-if=\"showListIcon\"></span>\n                                </a>\n                            </div>\n                            <div id=\"collapse6\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingSix\">\n                                <div class=\"panel-body\">\n                                    <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">Yes! We allow minor updates like changing your phone number, email, or uploading a newer CV. However, please note that any update or adjustment requested after 24 hours of your site going live will attract a small fee of ₦500 per update.<br><br>This helps us maintain quality and support quick turnaround times for everyone.</p>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n</section>",
          "_cid": "tlJSmYFMiE",
          "_anchor": "faq",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value",
              ".second-bg-color": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background-color": "@secondColor",
                "border-top-left-radius": "4.1666666667vw",
                "border-top-right-radius": "4.1666666667vw"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "position": "relative",
            ".text-wrapper": {
              "width": "100%"
            },
            ".mbr-section-title": {
              "color": "#2d2d2d",
              "@media (max-width: 991px)": {
                "text-align": "left !important"
              },
              "text-align": "center"
            },
            ".mbr-text": {
              "color": "#FFFFFF",
              "margin-right": "auto",
              "margin-top": "1rem",
              "@media (max-width: 991px)": {
                "text-align": "left !important"
              }
            },
            ".mbr-section-btn": {
              "margin-top": "1rem",
              "@media (max-width: 991px)": {
                "text-align": "left !important"
              }
            },
            ".custom-section-btn": {
              ".btn": {
                "padding": "2.5vw 5vw",
                "@media (max-width: 991px)": {
                  "padding": "24px 42px"
                }
              },
              ".btn-primary": {
                "border": "1px solid #FFFFFF !important",
                "&:hover": {
                  "border": "1px solid #FFFFFF !important"
                }
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "center",
              "color": "#000000"
            }
          },
          "_name": "afeatures3",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features3 orderm5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"8\" step=\"1\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#2d2d2d\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Second Bg Color\" name=\"secondBgColor\" condition=\"bg.type === 'color'\" checked>\n        <input type=\"color\" title=\"Second Color\" name=\"secondColor\" value=\"#dfe8ff\" condition=\"secondBgColor && bg.type === 'color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div class=\"second-bg-color\" mbr-if=\"secondBgColor\"></div>\n    <div class=\"container\">\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-lg-{{textWidth}}\">\n                <div class=\"text-wrapper\">\n                    <h1 class=\"mbr-section-title align-right mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Let Your CV Work Smarter</h1>\n                    <p class=\"mbr-text mbr-fonts-style align-right mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">You've worked hard to build your skills, experience, and story — now let the world see it in the best light. For just ₦2,500, MyCV.i.ng gives you a modern, professional CV website that works 24/7 to open doors and create opportunities.<br><br>No signups. No tech. No stress.<br><br>Just your CV, reimagined for the digital world.</p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn align-right custom-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-iconFont\"><a class=\"btn btn-primary\" href=\"https://tally.so/r/nGae6Z\" data-app-placeholder=\"Type Text\" target=\"_blank\">\n                            <div class=\"btn-transform\">Ready to Go Live?</div>\n                        </a> <a class=\"btn btn-black\" href=\"https://forms.gle/QFnm8kvG9AAdUHATA\" data-app-placeholder=\"Type Text\" target=\"_blank\">\n                            <div class=\"btn-transform\">Need a CV?</div>\n                        </a></div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tlJSwDYSq4",
          "_anchor": "cta",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
