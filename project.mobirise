              "color": "#2d2d2d"
            }
          },
          "_name": "aarticle2",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article2 orderm5\" group=\"Article\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"8\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"color\" title=\"Marker Color\" name=\"markerColor\" value=\"#000000\" condition=\"showList\">\n        <input type=\"range\" name=\"countItem\" title=\"Count\" min=\"1\" max=\"6\" value=\"6\" step=\"1\" condition=\"showList\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#dfe8ff\">\n        <input type=\"checkbox\" title=\"Second Bg Color\" name=\"secondBgColor\" checked>\n        <input type=\"color\" title=\"Second Color\" name=\"secondColor\" value=\"#fafafa\" condition=\"secondBgColor\">\n    </mbr-parameters>\n    <div class=\"second-bg-color\" mbr-if=\"secondBgColor\"></div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-4\"><b>What Information We Collect</b></h3>\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">When you use our service, we may collect the following information:</h4>\n                <div class=\"items-container\" mbr-if=\"showList\">\n                    <div class=\"item\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Your full name<br></p>\n                    </div>\n                    <div class=\"item\" mbr-if=\"countItem > 1\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            Email address\n                        </p>\n                    </div>\n\n                    <div class=\"item\" mbr-if=\"countItem > 2\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            Phone number (WhatsApp preferred)\n                        </p>\n                    </div>\n                    <div class=\"item\" mbr-if=\"countItem > 3\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            Your CV (PDF or Word format)\n                        </p>\n                    </div>\n                    <div class=\"item\" mbr-if=\"countItem > 4\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            Payment receipts or transaction details\n                        </p>\n                    </div>\n                    <div class=\"item\" mbr-if=\"countItem > 5\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            Optional sample links or additional design preferences<br><br><i>We do not collect sensitive personal data such as passwords, bank details, or biometric data.</i><br>\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uOmyaC7xYq",
          "_anchor": "info",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
