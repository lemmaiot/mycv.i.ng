            }
          },
          "_name": "afooter2",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer2 orderm5\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#2d2d2d\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#F5FF7D\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row align-center\">\n            <div class=\"col-12\">\n                <p class=\"mbr-text mb-0 mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".media-container-row .mbr-text\" data-app-placeholder=\"Type Text\">\n                    © Copyright 2025 <a href=\"http://lemmaiot.com.ng\" class=\"text-primary\" target=\"_blank\"><b>LemmaIoT </b></a>- All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tlJSdPfCNW",
          "_anchor": "afooter2-2",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        }
      ]
    },
    "profile_bk.html": {
      "settings": {
        "title": "Personal Profile Black",
        "order": "3",
        "socialSharingUrl": "",
        "meta_image": "@PROJECT_PATH@/assets/images/social-media-tag-design.jpg-1200x630.jpg"
      },
      "components": [
        {
          "_name": "aheader8",
          "_sourceTheme": "expertm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header8 expertm5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <header condition=\"showSocial\">Social</header>\n        <select title=\"Icons Align\" name=\"contentAlign\" condition=\"showSocial\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <input type=\"checkbox\" title=\"Social Title\" name=\"showSocialTitle\" condition=\"showSocial\" checked>\n        <input type=\"color\" title=\"Social Color\" name=\"socialColor\" value=\"#C4CFDE\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social BG Color 1\" name=\"socialBgColor1\" value=\"#4a90e2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social BG Color 2\" name=\"socialBgColor2\" value=\"#23272b\" condition=\"showSocial\">\n        <input type=\"checkbox\" name=\"socialShadow\" title=\"Social Shadow\" checked condition=\"showSocial\">\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"socialShadow1\" value=\"#191b1f\" condition=\"socialShadow && showSocial\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"socialShadow2\" value=\"#23272B\" condition=\"socialShadow && showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"6\" step=\"1\" value=\"3\" condition=\"showSocial\">\n        <header>Image</header>\n        <input type=\"checkbox\" name=\"imgBg\" title=\"Image BG\" checked>\n        <input type=\"color\" title=\"Image BG 1\" name=\"cardBg1\" value=\"#434343\" condition=\"imgBg\">\n        <input type=\"color\" title=\"Image BG 2\" name=\"cardBg2\" value=\"#4a90e2\" condition=\"imgBg\">\n        <input type=\"checkbox\" name=\"cardShadow\" title=\"Image Shadow\">\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"shadowColor1\" value=\"#232323\" condition=\"cardShadow\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"shadowColor2\" value=\"#232323\" condition=\"cardShadow\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background2.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#2d2d2d\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#212428\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center align-items-center\">\n            <div class=\"col-12 col-lg-7 col-text\">\n                <div class=\"text-wrapper\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\n                        WELCOME TO MY WORLD\n                    </h1>\n                    <h1 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\">\n                        <b>Hi, I’m <a href=\"#\" class=\"text-primary\">Agata Davis</a><br>\n                            a Photographer.</b>\n                    </h1>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                        Cursus vitae congue mauris rhoncus aenean vel elit scelerisque. Risus pretium quam vulputate\n                        dignissim suspendisse in auctor mauris augue, et necessitatibus adipisci.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn custom-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-danger\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            DOWNLOAD MY CV\n                        </a></div>\n                    <div class=\"social-container\" mbr-if=\"showSocial\">\n                        <p class=\"social-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSocialTitle\" data-app-selector=\".social-title\">\n                            FIND WITH ME\n                        </p>\n                        <div class=\"social-list {{contentAlign}}\">\n                            <div class=\"soc-item\" mbr-if=\"socialCount>0\">\n                                <span mbr-icon class=\"socicon-twitter socicon mbr-iconfont mbr-iconfont-social\"></span>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                                <span mbr-icon class=\"socicon-facebook socicon mbr-iconfont mbr-iconfont-social\"></span>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                                <span mbr-icon class=\"socicon-instagram socicon mbr-iconfont mbr-iconfont-social\"></span>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                                <span mbr-icon class=\"socicon-youtube socicon mbr-iconfont mbr-iconfont-social\"></span>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                                <span mbr-icon class=\"socicon-behance socicon mbr-iconfont mbr-iconfont-social\"></span>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>5\">\n                                <span mbr-icon class=\"socicon-vimeo socicon mbr-iconfont mbr-iconfont-social\"></span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5 col-img\">\n                <div class=\"img-wrapper\">\n                    <div class=\"img-box\">\n                        <img src=\"@PROJECT_PATH@/assets/images/gallery20.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".container": {
              "padding-left": "10px",
              "padding-right": "10px"
            },
            ".row": {
              "margin-left": "-10px",
              "margin-right": "-10px",
              "justify-content": "center",
              "> [class*=\"col\"]": {
                "padding-left": "10px",
                "padding-right": "10px"
              }
            },
            ".col-img": {
              "padding": "10px",
              "@media (min-width: 992px)": {
                "& when not (@reverseContent)": {
                  "padding-left": "30px !important"
                },
                "& when (@reverseContent)": {
                  "padding-right": "30px !important"
                }
              },
              "@media (max-width: 991px) and (min-width: 767px)": {
                "padding": "30px !important"
              }
            },
            ".col-text": {
              "display": "flex",
              "align-items": "center",
              "padding": "10px"
            },
            ".text-wrapper": {
              "width": "100%",
              "@media (max-width: 991px)": {
                "margin-bottom": "30px"
              }
            },
            ".mbr-section-title": {
              "color": "#ff9b8d",
              "margin-bottom": "20px"
            },
            ".mbr-section-subtitle": {
              "color": "#FFFFFF",
              "margin-bottom": "22px",
              "a": {
                "font-weight": "inherit",
                "pointer-events": "none"
              }
            },
            ".mbr-text": {
              "color": "#C4CFDE",
              "margin-bottom": "20px",
              "padding-right": "16%",
              "@media (max-width: 991px)": {
                "padding-right": "0"
              }
            },
            ".mbr-section-btn": {
              "margin-top": "20px"
            },
            ".social-container": {
              "width": "100%",
              "padding-top": "100px",
              "@media (max-width: 991px)": {
                "padding-top": "40px"
              }
            },
            ".social-title": {
              "color": "#ff9b8d",
              "margin-bottom": "20px"
            },
            ".social-list": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "margin": "-10px -12px"
            },
            ".soc-item": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative",
              "margin": "10px 12px",
              "min-width": "60px",
              "padding": "10px",
              "aspect-ratio": "(1 / 1)",
              "border-radius": "6px",
              "background": "linear-gradient(145deg, @socialBgColor1, @socialBgColor2)",
              "& when (@socialShadow)": {
                "box-shadow": "10px 10px 19px @socialShadow1, -10px -10px 19px @socialShadow2"
              },
              "transition": "0.4s all",
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "z-index": "4",
                "transition": "0.4s all",
                "width": "100%",
                "height": "100%",
                "border-radius": "5px",
                "background": "linear-gradient(to right bottom, #212428, #16181c)",
                "opacity": "0"
              },
              ".mbr-iconfont": {
                "position": "relative",
                "z-index": "5",
                "transition": "0.4s all",
                "font-size": "22px",
                "color": "@socialColor"
              },
              "&:hover": {
                "transform": "translateY(-3px)",
                "&:before": {
                  "opacity": "1"
                }
              },
              "a": {
                "animation": "none"
              }
            },
            ".img-wrapper": {
              "padding": "15px",
              "border-radius": "6px",
              "position": "relative",
              "width": "100%",
              "& when (@imgBg)": {
                "background": "linear-gradient(to right, @cardBg1, @cardBg2)"
              },
              "& when (@cardShadow)": {
                "box-shadow": "10px 10px 19px @shadowColor1, -10px -10px 19px @shadowColor2"
              }
            },
            ".img-box": {
              "width": "100%",
              "border-radius": "6px",
              "overflow": "hidden",
              "img": {
                "width": "100%",
                "object-fit": "cover",
                "aspect-ratio": "(700 / 933)"
              }
            }
          },
          "_cid": "uShskCu0Gg",
          "_anchor": "aheader8-u",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "afeatures11",
          "_sourceTheme": "expertm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features11 expertm5\" group=\"Features\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Lines Title\" name=\"showCardsTitle\" checked>\n        <input type=\"checkbox\" title=\"Lines Subtitle\" name=\"showCardsSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Lines Text\" name=\"showLinesText\" checked>\n        <input type=\"range\" inline title=\"List Count\" name=\"listCount\" min=\"1\" max=\"2\" step=\"1\" value=\"2\">\n        <select title=\"Lines 1\" name=\"cardsAmount1\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n        </select>\n        <select title=\"Lines 2\" name=\"cardsAmount2\" condition=\"listCount >1\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n        </select>\n        <header>Lines 1</header>\n        <input type=\"range\" inline title=\"Line Active 1\" name=\"line1Active1\" min=\"0\" max=\"100\" step=\"1\" value=\"95\">\n        <input type=\"range\" inline title=\"Line Active 2\" name=\"line1Active2\" min=\"0\" max=\"100\" step=\"1\" value=\"70\" condition=\"cardsAmount1 >1\">\n        <input type=\"range\" inline title=\"Line Active 3\" name=\"line1Active3\" min=\"0\" max=\"100\" step=\"1\" value=\"78\" condition=\"cardsAmount1 >2\">\n        <input type=\"range\" inline title=\"Line Active 4\" name=\"line1Active4\" min=\"0\" max=\"100\" step=\"1\" value=\"73\" condition=\"cardsAmount1 >3\">\n        <input type=\"range\" inline title=\"Line Active 5\" name=\"line1Active5\" min=\"0\" max=\"100\" step=\"1\" value=\"92\" condition=\"cardsAmount1 >4\">\n        <header condition=\"listCount >1\">Lines 2</header>\n        <input type=\"range\" inline title=\"Line Active 1\" name=\"line2Active1\" min=\"0\" max=\"100\" step=\"1\" value=\"94\" condition=\"listCount >1\">\n        <input type=\"range\" inline title=\"Line Active 2\" name=\"line2Active2\" min=\"0\" max=\"100\" step=\"1\" value=\"88\" condition=\"cardsAmount2 >1 &amp;&amp; listCount >1\">\n        <input type=\"range\" inline title=\"Line Active 3\" name=\"line2Active3\" min=\"0\" max=\"100\" step=\"1\" value=\"98\" condition=\"cardsAmount2 >2 &amp;&amp; listCount >1\">\n        <input type=\"range\" inline title=\"Line Active 4\" name=\"line2Active4\" min=\"0\" max=\"100\" step=\"1\" value=\"99\" condition=\"cardsAmount2 >3 &amp;&amp; listCount >1\">\n        <input type=\"range\" inline title=\"Line Active 5\" name=\"line2Active5\" min=\"0\" max=\"100\" step=\"1\" value=\"100\" condition=\"cardsAmount2 >4 &amp;&amp; listCount >1\">\n        <header>Lines Style</header>\n        <input type=\"color\" title=\"Lines Text Color\" name=\"linesTextColor\" value=\"#C4CFDE\">\n        <input type=\"color\" title=\"Lines BG\" name=\"linesBg\" value=\"#212428\">\n        <input type=\"color\" title=\"Lines Active BG 1\" name=\"linesBg1\" value=\"#4a90e2\">\n        <input type=\"color\" title=\"Lines Active BG 2\" name=\"linesBg2\" value=\"#f55e4a\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#2d2d2d\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#212428\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showMainTitle || showMainSubtitle\">\n                <div class=\"mbr-section-head\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                        9+ YEARS OF EXPERIENCE\n                    </h3>\n                    <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                       <b>My Resume</b>\n                    </h5>\n                </div>\n            </div>\n        </div>\n        <div class=\"row card-row {{contentAlign}}\">\n            <div class=\"cards-container cards-container-1 col-12 col-md-6\">\n                <div class=\"cards-head\" mbr-if=\"showCardsTitle || showCardsSubtitle\">\n                    <h3 class=\"cards-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardsTitle\" data-app-selector=\".cards-title\">\n                        Features\n                    </h3>\n                    <h5 class=\"cards-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showCardsSubtitle\" data-app-selector=\".cards-subtitle\">\n                        <b>Design Skill</b>\n                    </h5>\n                </div>\n                <div class=\"cards-list\">\n                    <div class=\"lines-wrap\">\n                        <div class=\"line-item-container\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                PHOTOSHOT\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line1-item-active-1\">\n                                    <span class=\"percent-text percent-text1\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount1 >1\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                FIGMA\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line1-item-active-2\">\n                                    <span class=\"percent-text percent-text2\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount1 >2\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                ADOBE XD.\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line1-item-active-3\">\n                                    <span class=\"percent-text percent-text3\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount1 >3\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                ADOBE ILLUSTRATOR\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line1-item-active-4\">\n                                    <span class=\"percent-text percent-text4\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount1 >4\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                DESIGN\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line1-item-active-5\">\n                                    <span class=\"percent-text percent-text5\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"cards-container cards-container-2 col-12 col-md-6\" mbr-if=\"listCount > 1\">\n                <div class=\"cards-head\" mbr-if=\"showCardsTitle || showCardsSubtitle\">\n                    <h3 class=\"cards-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardsTitle\" data-app-selector=\".cards-title\">\n                        Features\n                    </h3>\n                    <h5 class=\"cards-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showCardsSubtitle\" data-app-selector=\".cards-subtitle\">\n                        <b>Development Skill</b>\n                    </h5>\n                </div>\n                <div class=\"cards-list\">\n                    <div class=\"lines-wrap\">\n                        <div class=\"line-item-container\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                PLUGIN\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line2-item-active-1\">\n                                    <span class=\"percent-text percent-text1\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount2 >1\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                SOFTWARE\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line2-item-active-2\">\n                                    <span class=\"percent-text percent-text2\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount2 >2\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                JAVASCRIPT\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line2-item-active-3\">\n                                    <span class=\"percent-text percent-text3\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount2 >3\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                CSS\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line2-item-active-4\">\n                                    <span class=\"percent-text percent-text4\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount2 >4\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                HTML\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line2-item-active-5\">\n                                    <span class=\"percent-text percent-text5\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "overflow": "hidden",
            ".container": {
              "padding-left": "15px",
              "padding-right": "15px",
              "@media (max-width: 1599px)": {
                "padding-left": "10px",
                "padding-right": "10px"
              }
            },
            ".row": {
              "margin-left": "-30px",
              "margin-right": "-30px",
              "justify-content": "flex-start",
              "> [class*=\"col\"]": {
                "padding-left": "30px",
                "padding-right": "30px"
              },
              "@media (max-width: 991px)": {
                "margin-left": "-15px",
                "margin-right": "-15px",
                "> [class*=\"col\"]": {
                  "padding-left": "15px",
                  "padding-right": "15px"
                }
              }
            },
            ".mbr-section-head": {
              "width": "100%",
              "padding-bottom": "40px"
            },
            ".mbr-section-title": {
              "color": "#ff9b8d",
              "@media (max-width: 767px)": {
                "text-align": "center"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#C4CFDE",
              "margin-top": "15px",
              "@media (max-width: 767px)": {
                "margin-top": "10px",
                "text-align": "center"
              }
            },
            ".card-row": {
              "align-items": "stretch"
            },
            ".cards-container-2": {
              "@media (max-width: 767px)": {
                "margin-top": "30px"
              }
            },
            ".cards-head": {
              "width": "100%",
              "margin-bottom": "24px"
            },
            ".cards-title": {
              "color": "#ff9b8d"
            },
            ".cards-subtitle": {
              "color": "#C4CFDE",
              "margin-top": "15px",
              "@media (max-width: 767px)": {
                "margin-top": "10px"
              }
            },
            ".cards-list": {
              "width": "100%"
            },
            ".lines-wrap": {
              "width": "100%"
            },
            ".line-item-container": {
              "width": "100%",
              "&:not(:first-child)": {
                "margin-top": "30px"
              }
            },
            ".line-text": {
              "color": "#C4CFDE",
              "opacity": "0.75",
              "margin-bottom": "10px"
            },
            ".line-item": {
              "width": "100%",
              "height": "13px",
              "padding": "3px",
              "background-color": "@linesBg",
              "border-radius": "10px",
              "box-shadow": "inset 8px 8px 16px rgba(0, 0, 0, 0.46), inset -8px -8px 16px rgba(56, 62, 69, 0.46)"
            },
            ".line-item-active": {
              "position": "relative",
              "height": "100%",
              "border-radius": "14px",
              "transition": "width .6s ease",
              "background": "linear-gradient(145deg, @linesBg1 0%, @linesBg2 100%)"
            },
            ".line1-item-active-1": {
              "width": "(@line1Active1 * 1%)",
              ".percent-text1": {
                "&:before": {
                  "content": "\"@{line1Active1}\""
                }
              }
            },
            ".line1-item-active-2": {
              "width": "(@line1Active2 * 1%)",
              ".percent-text2": {
                "&:before": {
                  "content": "\"@{line1Active2}\""
                }
              }
            },
            ".line1-item-active-3": {
              "width": "(@line1Active3 * 1%)",
              ".percent-text3": {
                "&:before": {
                  "content": "\"@{line1Active3}\""
                }
              }
            },
            ".line1-item-active-4": {
              "width": "(@line1Active4 * 1%)",
              ".percent-text4": {
                "&:before": {
                  "content": "\"@{line1Active4}\""
                }
              }
            },
            ".line1-item-active-5": {
              "width": "(@line1Active5 * 1%)",
              ".percent-text5": {
                "&:before": {
                  "content": "\"@{line1Active5}\""
                }
              }
            },
            ".line2-item-active-1": {
              "width": "(@line2Active1 * 1%)",
              ".percent-text1": {
                "&:before": {
                  "content": "\"@{line2Active1}\""
                }
              }
            },
            ".line2-item-active-2": {
              "width": "(@line2Active2 * 1%)",
              ".percent-text2": {
                "&:before": {
                  "content": "\"@{line2Active2}\""
                }
              }
            },
            ".line2-item-active-3": {
              "width": "(@line2Active3 * 1%)",
              ".percent-text3": {
                "&:before": {
                  "content": "\"@{line2Active3}\""
                }
              }
            },
            ".line2-item-active-4": {
              "width": "(@line2Active4 * 1%)",
              ".percent-text4": {
                "&:before": {
                  "content": "\"@{line2Active4}\""
                }
              }
            },
            ".line2-item-active-5": {
              "width": "(@line2Active5 * 1%)",
              ".percent-text5": {
                "&:before": {
                  "content": "\"@{line2Active5}\""
                }
              }
            },
            ".percent-text": {
              "position": "absolute",
              "right": "0",
              "top": "-27px",
              "font-weight": "400",
              "color": "@linesTextColor",
              "font-size": "16px",
              "text-transform": "uppercase",
              "letter-spacing": "2px",
              "opacity": "0.9"
            }
          },
