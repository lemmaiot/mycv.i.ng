        {
          "_name": "afeatures10",
          "_sourceTheme": "expertm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features10 expertm5\" group=\"Features\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Cards Title\" name=\"showCardsTitle\" checked>\n        <input type=\"checkbox\" title=\"Cards Subtitle\" name=\"showCardsSubtitle\" checked>\n        <input type=\"range\" inline title=\"List Count\" name=\"listCount\" min=\"1\" max=\"2\" step=\"1\" value=\"2\">\n        <select title=\"Cards 1\" name=\"cardsAmount1\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <select title=\"Cards 2\" name=\"cardsAmount2\" condition=\"listCount >1\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n        </select>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Label\" name=\"showLabel\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Card Style</header>\n        <input type=\"color\" title=\"Card Frame Color\" name=\"cardFrameColor\" value=\"#16181c\">\n        <input type=\"color\" title=\"Card BG 1\" name=\"cardBg1\" value=\"#1e2024\">\n        <input type=\"color\" title=\"Card BG 2\" name=\"cardBg2\" value=\"#23272b\">\n        <input type=\"checkbox\" name=\"cardBorder\" title=\"Card Border\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#16181c\" condition=\"cardBorder\">\n        <input type=\"checkbox\" name=\"cardShadow\" title=\"Card Shadow\" checked>\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"shadowColor1\" value=\"#191b1f\" condition=\"cardShadow\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"shadowColor2\" value=\"#23272B\" condition=\"cardShadow\">\n        <header>Card Hover</header>\n        <input type=\"color\" title=\"Card Text Color\" name=\"cardHoverText\" value=\"#FFFFFF\">\n        <input type=\"color\" title=\"Card BG 1\" name=\"cardHoverBg1\" value=\"#212428\">\n        <input type=\"color\" title=\"Card BG 2\" name=\"cardHoverBg2\" value=\"#16181c\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"color\" title=\"Color\" value=\"#2d2d2d\" selected>\n        </fieldset>\n    </mbr-parameters>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showMainTitle || showMainSubtitle\">\n                <div class=\"mbr-section-head\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                        9+ YEARS OF EXPERIENCE\n                    </h3>\n                    <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                       <b>My Resume</b>\n                    </h5>\n                </div>\n            </div>\n        </div>\n        <div class=\"row card-row {{contentAlign}}\">\n            <div class=\"cards-container cards-container-1 col-12 col-md-6\">\n                <div class=\"cards-head\" mbr-if=\"showCardsTitle || showCardsSubtitle\">\n                    <h3 class=\"cards-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardsTitle\" data-app-selector=\".cards-title\">\n                        1997 - 2010\n                    </h3>\n                    <h5 class=\"cards-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showCardsSubtitle\" data-app-selector=\".cards-subtitle\">\n                        <b>Education Quality</b>\n                    </h5>\n                </div>\n                <div class=\"cards-list\" mbr-if=\"showSubtitle || showTitle || showText || showLabel\">\n                    <div class=\"card\">\n                        <div class=\"card-wrapper\">\n                            <div class=\"card-bg\"></div>\n                            <div class=\"card-box\">\n                                <div class=\"card-text-container\" mbr-if=\"showTitle || showSubtitle || showLabel\">\n                                    <div class=\"card-text-wrap\" mbr-if=\"showTitle || showSubtitle\">\n                                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                            <b>Ultricies tristique nulla</b>\n                                        </h5>\n                                        <h6 class=\"card-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                            Cum sociis (2006 - 2010)\n                                        </h6>\n                                    </div>\n                                    <div class=\"card-text-label\" mbr-if=\"showLabel\">\n                                        <p class=\"card-label mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-label\">\n                                            3.95/4\n                                        </p>\n                                    </div>\n                                </div>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                    Risus ultricies tristique nulla aliquet enim tortor at. Consectetur adipiscing elit\n                                    duis tristique sollicitudin nibh sit.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardsAmount1 > 1\">\n                        <div class=\"card-wrapper\">\n                            <div class=\"card-bg\"></div>\n                            <div class=\"card-box\">\n                                <div class=\"card-text-container\" mbr-if=\"showTitle || showSubtitle || showLabel\">\n                                    <div class=\"card-text-wrap\" mbr-if=\"showTitle || showSubtitle\">\n                                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                            <b>Cras sed felis eget</b>\n                                        </h5>\n                                        <h6 class=\"card-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                            Quisque sagittis (2001 - 2005)\n                                        </h6>\n                                    </div>\n                                    <div class=\"card-text-label\" mbr-if=\"showLabel\">\n                                        <p class=\"card-label mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-label\">\n                                            4.86/5\n                                        </p>\n                                    </div>\n                                </div>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                    Ut tellus elementum sagittis vitae. At varius vel pharetra vel turpis nunc eget\n                                    lorem. Non arcu risus quis varius quam quisque id.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardsAmount1 > 2\">\n                        <div class=\"card-wrapper\">\n                            <div class=\"card-bg\"></div>\n                            <div class=\"card-box\">\n                                <div class=\"card-text-container\" mbr-if=\"showTitle || showSubtitle || showLabel\">\n                                    <div class=\"card-text-wrap\" mbr-if=\"showTitle || showSubtitle\">\n                                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                            <b>Vestibulum lorem sed</b>\n                                        </h5>\n                                        <h6 class=\"card-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                            Pellentesque nec (1998 - 2000)\n                                        </h6>\n                                    </div>\n                                    <div class=\"card-text-label\" mbr-if=\"showLabel\">\n                                        <p class=\"card-label mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-label\">\n                                            5.00/5\n                                        </p>\n                                    </div>\n                                </div>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                    Consectetur adipiscing elit duis tristique sollicitudin nibh sit amet. Enim neque\n                                    volutpat ac tincidunt vitae.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"cards-container cards-container-2 col-12 col-md-6\" mbr-if=\"listCount > 1\">\n                <div class=\"cards-head\" mbr-if=\"showCardsTitle || showCardsSubtitle\">\n                    <h3 class=\"cards-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardsTitle\" data-app-selector=\".cards-title\">\n                        2010 - 2022\n                    </h3>\n                    <h5 class=\"cards-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showCardsSubtitle\" data-app-selector=\".cards-subtitle\">\n                        <b>Job Experience</b>\n                    </h5>\n                </div>\n                <div class=\"cards-list\" mbr-if=\"showSubtitle || showTitle || showText || showLabel\">\n                    <div class=\"card\">\n                        <div class=\"card-wrapper\">\n                            <div class=\"card-bg\"></div>\n                            <div class=\"card-box\">\n                                <div class=\"card-text-container\" mbr-if=\"showTitle || showSubtitle || showLabel\">\n                                    <div class=\"card-text-wrap\" mbr-if=\"showTitle || showSubtitle\">\n                                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                            <b>Porttitor lacus luctus</b>\n                                        </h5>\n                                        <h6 class=\"card-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                            Volutpat commodo - (2017 - Present)\n                                        </h6>\n                                    </div>\n                                    <div class=\"card-text-label\" mbr-if=\"showLabel\">\n                                        <p class=\"card-label mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-label\">\n                                            USA\n                                        </p>\n                                    </div>\n                                </div>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                    Nulla facilisi cras fermentum odio. Pulvinar elementum integer enim neque volutpat\n                                    ac tincidunt vitae.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardsAmount2 > 1\">\n                        <div class=\"card-wrapper\">\n                            <div class=\"card-bg\"></div>\n                            <div class=\"card-box\">\n                                <div class=\"card-text-container\" mbr-if=\"showTitle || showSubtitle || showLabel\">\n                                    <div class=\"card-text-wrap\" mbr-if=\"showTitle || showSubtitle\">\n                                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                            <b>Tincidunt dui ut ornare</b>\n                                        </h5>\n                                        <h6 class=\"card-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                            Nec ullamcorper sit - (2012 - 2016)\n                                        </h6>\n                                    </div>\n                                    <div class=\"card-text-label\" mbr-if=\"showLabel\">\n                                        <p class=\"card-label mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-label\">\n                                            INDIA\n                                        </p>\n                                    </div>\n                                </div>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                    Quis imperdiet massa tincidunt nunc pulvinar sapien et ligula ullamcorper.\n                                    Vestibulum sed arcu non odio euismod.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"card\" mbr-if=\"cardsAmount2 > 2\">\n                        <div class=\"card-wrapper\">\n                            <div class=\"card-bg\"></div>\n                            <div class=\"card-box\">\n                                <div class=\"card-text-container\" mbr-if=\"showTitle || showSubtitle || showLabel\">\n                                    <div class=\"card-text-wrap\" mbr-if=\"showTitle || showSubtitle\">\n                                        <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                            <b>Etiam dignissim diam</b>\n                                        </h5>\n                                        <h6 class=\"card-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                            Scelerisque eleifend - (2020 - 2011)\n                                        </h6>\n                                    </div>\n                                    <div class=\"card-text-label\" mbr-if=\"showLabel\">\n                                        <p class=\"card-label mbr-fonts-style\" mbr-theme-style=\"display-7\" data-app-selector=\".card-label\">\n                                            MALAYSIA\n                                        </p>\n                                    </div>\n                                </div>\n                                <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                    Sit amet mattis vulputate enim. Diam sit amet nisl suscipit adipiscing bibendum.\n                                    A lacus vestibulum sed arcu.\n                                </p>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n\n        </div>\n\n\n    </div>\n</section>",
