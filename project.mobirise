  "pages": {
    "index.html": {
      "settings": {
        "main": true,
        "title": "Create a Personal CV Website in 24hrs",
        "meta_descr": "Get your CV hosted as a sleek, professional website at just ₦2,500. Submit CV + Payment, and go live within 24hrs!",
        "header_custom": "<meta property=\"og:title\" content=\"Create a Personal CV Website in 24hrs – MyCV.i.ng\" />\n<meta property=\"og:description\" content=\"Get your CV hosted as a sleek, professional website at just ₦2,500. Submit CV + Payment, and go live within 24hrs!\" />\n<meta property=\"og:image\" content=\"https://mycv.i.ng/assets/preview-image.jpg\" />\n<meta property=\"og:url\" content=\"https://www.mycv.i.ng\" />\n<meta property=\"og:type\" content=\"website\" />\n<script async src=\"https://tally.so/widgets/embed.js\"></script>",
        "footer_custom": "<script>\n  // Get the current URL path (without slashes)\n  const path = window.location.pathname.replace(/^\\/+|\\/+$/g, '');\n\n  // Allow only homepage; redirect everything else to error.html\n  if (path && path !== 'index.html') {\n    window.location.href = '/error.html';\n  }\n</script>",
        "html_before": "",
        "meta_image": "@PROJECT_PATH@/assets/images/social-media-tag-design.jpg-1200x630.jpg"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            ".mbr-section-head": {
              "width": "100%",
              "margin-bottom": "5vw",
              "@media (max-width: 991px)": {
                "margin-bottom": "8.2vw"
              },
              "@media (max-width: 767px)": {
                "margin-bottom": "10.6666666667vw"
              }
            },
            ".mbr-section-title": {
              "color": "#000000",
              "margin-bottom": "0"
            },
            ".iconfont-wrapper": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "background-color": "@iconBgColor",
              "padding": "36px",
              "border-radius": "16px",
              "margin-right": "20px",
              "margin-bottom": "20px",
              "margin-top": "20px",
              "float": "left",
              "& when (@iconBorder)": {
                "border": "1px solid @iconBorderColor"
              },
              "@media (max-width: 991px)": {
                "border-radius": "100%",
                "padding": "0",
                "width": "10.67vw",
                "height": "10.67vw",
                "margin-bottom": "0"
              },
              "@media (max-width: 767px)": {
                "width": "15.67vw",
                "height": "15.67vw",
                "margin-right": "12px",
                "margin-top": "12px"
              },
              ".mbr-iconfont": {
                "color": "@iconColor",
                "font-size": "54px",
                "@media (max-width: 991px)": {
                  "font-size": "5.6vw !important"
                },
                "@media (max-width: 767px)": {
                  "font-size": "8vw !important"
                }
              }
            },
            ".mbr-section-subtitle": {
              "color": "#ffffff",
              "margin-bottom": "0",
              "margin-top": "32px"
            },
            ".mbr-section-title-2": {
              "color": "#dfe8ff"
            },
            ".mbr-section-title-3": {
              "color": "#dfe8ff"
            },
            ".mbr-section-title-1": {
              "color": "#ffffff"
            }
          },
          "_name": "aheader2",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header2\" group=\"Header\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n    'mbr-fullscreen': fullScreen,\n    'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"10\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline name=\"textWidth\" title=\"Form Width\" min=\"5\" max=\"12\" value=\"6\" step=\"1\" condition=\"showForm\">\n        <select title=\"Form Align\" name=\"contentAlign\" condition=\"showForm\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\" selected>Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title 1\" name=\"showTitle1\" checked>\n        <input type=\"checkbox\" title=\"Title 2\" name=\"showTitle2\" checked>\n        <input type=\"checkbox\" title=\"Icons\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#000000\" selected condition=\"showIcon\">\n        <input type=\"color\" title=\"Icon BG Color\" name=\"iconBgColor\" value=\"#4a90e2\" selected condition=\"showIcon\">\n        <input type=\"checkbox\" title=\"Icons Border\" name=\"iconBorder\" checked condition=\"showIcon\">\n        <input type=\"color\" title=\"Icon Border Color\" name=\"iconBorderColor\" value=\"#000000\" selected condition=\"showIcon && iconBorder\">\n        <input type=\"checkbox\" title=\"Title 3\" name=\"showTitle3\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Form\" name=\"showForm\" checked>\n        <input type=\"checkbox\" title=\"Form Title\" name=\"showFormTitle\" condition=\"showForm\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/1.jpg-1280x960.jpg\" selected parallax>\n            <input type=\"color\" title=\"Color\" value=\"#ede7e2\">\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#000000\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-12\">\n                <div class=\"mbr-section-head\" mbr-if=\"showTitle1 || showTitle2 || showTitle3 || showIcon || showSubtitle\">\n                    <h3 class=\"mbr-section-title mbr-section-title-1 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle1\" data-app-selector=\".mbr-section-title-1\"><br>\n                    </h3>\n                    <div class=\"title-container\">\n                        <div class=\"iconfont-wrapper\" mbr-if=\"showIcon\">\n                            <span mbr-icon class=\"mbr-iconfont mbrib-website-theme\"></span>\n                        </div>\n                        <h3 class=\"mbr-section-title mbr-section-title-2 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-1\" mbr-if=\"showTitle2\" data-app-selector=\".mbr-section-title-2\">Turn Your CV</h3>\n                    </div>\n                    <h3 class=\"mbr-section-title mbr-section-title-3 mb-0 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle3\" data-app-selector=\".mbr-section-title-3\">Into a Website in 1 Day</h3>\n                    <h4 class=\"mbr-section-subtitle mb-0 mbr-fonts-style\" mbr-theme-style=\"display-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">Turn your resume into a personal website — hosted, styled, and ready in 24 hours for just ₦2,500.<div>You upload. We do the rest.</div></h4>\n                </div>\n            </div>\n        </div>\n        <div class=\"row {{contentAlign}}\" mbr-if=\"showForm\">\n            <div class=\"form-container col-12 col-lg-{{textWidth}}\">\n                <h5 mbr-text class=\"form-title mbr-fonts-style align-right mb-3\" data-app-selector=\".form-title\" mbr-theme-style=\"display-5\" mbr-if=\"showFormTitle\">\n                    SUBSCRIBE FOR WEEKLY <br>\n                    CONTENT UPDATES\n                </h5>\n                <div class=\"form-wrapper\">\n                    <div mbr-form class=\"mbr-form\">\n                        <form action=\"getmycf@gmail.com\" name=\"Form Name\" method=\"POST\" class=\"mbr-form form-with-styler\" data-verified=\"getmycf@gmail.com\">\n                            <div class=\"row\">\n                                <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">Thanks for Subscribing, we will keep you update on our any improvement.</div>\n                                <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">\n                                    Oops...! some problem!\n                                </div>\n                            </div>\n                            <div class=\"dragArea row\">\n                                <div class=\"col-12 col-lg form-group\" data-for=\"email\">\n                                    <input type=\"email\" name=\"email\" placeholder=\"ENTER YOUR EMAIL...\" data-form-field=\"Email\" class=\"form-control\">\n                                </div>\n                                <div class=\"mbr-section-btn custom-section-btn col-lg-auto col-auto\" mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\"><a type=\"submit\" class=\"btn btn-black\" data-app-placeholder=\"Type Text\">\n                                    <span class=\"btn-transform\">\n                                        SUBSCRIBE\n                                    </span>\n                                    </a></div>\n                            </div>\n                        </form>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tlJMIKbuHg",
          "_anchor": "header",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value",
              ".second-bg-color": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background-color": "@secondColor",
                "border-top-left-radius": "4.1666666667vw",
                "border-top-right-radius": "4.1666666667vw"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "position": "relative",
            ".container": {
              "@media (max-width: 991px)": {
                "padding": "0 !important"
              }
            },
            ".mbr-section-head": {
              "width": "100%",
              "margin-bottom": "5.5555555556vw",
              "@media (max-width: 991px)": {
                "margin-bottom": "8.2vw",
                "padding": "0 5.3vw"
              },
              "@media (max-width: 767px)": {
                "margin-bottom": "10.6666666667vw"
              }
            },
            ".mbr-section-title": {
              "color": "#dfe8ff",
              "margin-bottom": "0",
              "@media (max-width: 991px)": {
                "text-align": "left"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#000000",
              "margin-bottom": "0",
              "margin-top": "32px",
              "@media (max-width: 991px)": {
                "text-align": "left"
              }
            },
            ".accordion-wrap": {
              "display": "flex",
              "align-items": "stretch",
              "position": "relative",
              "width": "100%",
              "border-radius": "1.7vw",
              "overflow": "hidden",
              "& when (@showBorder)": {
                "border": "1px solid @borderColor"
              },
              "@media (max-width: 991px)": {
                "border-radius": "0",
                "border-left": "none",
                "border-right": "none"
              }
            },
            ".panel-group": {
              "border": "none",
              "width": "100%",
              "& when (@showImg)": {
                "width": "35%",
                "& when (@showBorder)": {
                  "border-right": "1px solid @borderColor"
                }
              },
              "@media (max-width: 991px)": {
                "width": "100%",
                "border-right": "none"
              }
            },
            ".card": {
              "position": "static",
              "padding": "0",
              "margin": "0",
              "&:not(:first-child)": {
                "& when (@showBorder)": {
                  "border-top": "1px solid @borderColor"
                }
              }
            },
            ".card-header": {
              "background-color": "transparent",
              "margin-bottom": "0",
              "padding": "0",
              "border": "none"
            },
            ".panel-title": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "space-between",
              "padding": "2.8vw 2.2vw",
              "@media (max-width: 991px)": {
                "padding": "7.2vw 5.3333333333vw 7.7vw"
              },
              "@media (max-width: 767px)": {
                "padding": "8.5333333333vw 5.3333333333vw 9.0666666667vw"
              },
              "&[aria-expanded=\"true\"]": {
                "padding-bottom": "0.8vw",
                "@media (max-width: 991px)": {
                  "padding-bottom": "7.7vw"
                },
                "@media (max-width: 767px)": {
                  "padding-bottom": "9.0666666667vw"
                },
                ".sign": {
                  "opacity": "0",
                  "transform": "rotate(180deg)"
                },
                "& when (@showCardOpenBg)": {
                  "background-color": "@cardOpenBgColor"
                }
              }
            },
            ".panel-title-edit": {
              "color": "#dfe8ff",
              "margin-right": "1rem"
            },
            ".panel-body": {
              "padding": "0 2.2vw 1.7vw",
              "transition": "background 0.4s  !important",
              "@media (max-width: 991px)": {
                "padding": "0 5.3333333333vw 7.7vw"
              },
              "@media (max-width: 767px)": {
                "padding": "0 5.3333333333vw 9.0666666667vw"
              }
            },
            ".sign": {
              "font-family": "'Moririse2' !important",
              "padding": "10px",
              "font-size": "18px",
              "border-radius": "50%",
              "color": "@iconColor",
              "border": "1px solid @iconColor",
              "transition": "0.3s all",
              "animation": "icon-move-out 0.2s ease-out",
              "&:hover": {
                "animation": "icon-move 0.8s forwards"
              }
            },
            ".image-wrapper": {
              "position": "absolute",
              "left": "35%",
              "top": "0",
              "width": "65%",
              "height": "100%",
              "img": {
                "width": "100%",
                "height": "100%",
                "object-fit": "cover"
              },
              "@media (max-width: 991px)": {
                "position": "static",
                "width": "100%",
                "height": "auto",
                "aspect-ratio": "1.68",
                "& when (@showBorder)": {
                  "border-top": "1px solid @borderColor"
                }
              }
            },
            ".panel-collapse": {
              "&:not(.collapse)": {
                ".panel-body": {
                  "& when (@showCardOpenBg)": {
                    "background-color": "@cardOpenBgColor"
                  }
                }
              },
              "&.show": {
                ".panel-body": {
                  "& when (@showCardOpenBg)": {
                    "background-color": "@cardOpenBgColor"
                  }
                }
              }
            },
            "@keyframes icon-move": {
              "0%": {
                "transform": "translate3d(0, 0%, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg)",
                "will-change": "transform"
              },
              "80%": {
                "transform": "translate3d(0, 0%, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(360deg) skew(0deg, 0deg)"
              },
              "100%": {
                "transform": "translate3d(0, 0%, 0px) scale3d(1.2, 1.2, 1) rotateX(0deg) rotateY(0deg) rotateZ(360deg) skew(0deg, 0deg)",
                "will-change": "auto"
              }
            },
            "@keyframes icon-move-out": {
              "0%": {
                "transform": "translate3d(0, 0%, 0px) scale3d(1.2, 1.2, 1) rotateX(0deg) rotateY(0deg) rotateZ(0) skew(0deg, 0deg)",
                "will-change": "transform"
              },
              "100%": {
                "transform": "translate3d(0, 0%, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0) skew(0deg, 0deg)",
                "will-change": "auto"
              }
            },
            ".panel-text": {
              "color": "#ffffff"
            }
          },
          "_name": "alist1",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"list1 orderm5\" group=\"List\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background':bg.parallax}\" plugins=\"mbr-switch-arrow, mobirise-icons2\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"7\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Icon\" name=\"showIcon\" checked>\n        <input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#d8d0ca\" condition=\"showIcon\">\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked>\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#d8d0ca\" condition=\"showBorder\">\n        <input type=\"checkbox\" title=\"Card Open Bg\" name=\"showCardOpenBg\" checked>\n        <input type=\"color\" title=\"Card Open Bg Color\" name=\"cardOpenBgColor\" value=\"#4a90e2\" condition=\"showCardOpenBg\">\n        <input type=\"checkbox\" title=\"Image\" name=\"showImg\" checked>\n        <select title=\"Amount\" name=\"cardAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\" selected>4</option>\n        </select>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#2d2d2d\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Second Bg Color\" name=\"secondBgColor\" condition=\"bg.type === 'color'\">\n        <input type=\"color\" title=\"Second Color\" name=\"secondColor\" value=\"#434343\" condition=\"secondBgColor && bg.type === 'color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#FFFFFF\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.9\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div class=\"second-bg-color\" mbr-if=\"secondBgColor\"></div>\n    <div class=\"container\">\n        <div class=\"mbr-section-head align-right\" mbr-if=\"showTitle || showSubtitle\">\n            <h3 class=\"mbr-section-title mb-0 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\">Why Choose MyCV.i.ng?</h3>\n            <h4 class=\"mbr-section-subtitle mb-0 align-right mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                Libero id faucibus nisl tincidunt eget nullam non.<br>\n                Dolor magna eget est lorem ipsum dolor sit.\n            </h4>\n        </div>\n        <div class=\"accordion-wrap\">\n            <div id=\"bootstrap-accordion\" class=\"panel-group accordionStyles accordion\" role=\"tablist\" aria-multiselectable=\"true\">\n                <div class=\"card\">\n                    <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                        <a role=\"button\" class=\"panel-title\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse1\" aria-expanded=\"true\" aria-controls=\"collapse1\">\n                            <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>1. Professional Online Presence</b></h6>\n                            <span class=\"sign mbr-iconfont mobi-mbri-plus\" mbr-if=\"showIcon\"></span>\n                        </a>\n                    </div>\n                    <div id=\"collapse1\" class=\"panel-collapse noScroll collapse show\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                        <div class=\"panel-body\">\n                            <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                In today’s world, first impressions are digital. With your own personalized URL (like www.mycv.i.ng/yourname), you instantly stand out from the crowd. Whether you’re applying for jobs, freelancing, or networking, your online CV makes a bold, clean statement — and it’s 100% mobile and recruiter-friendly.\n                            </p>\n                        </div>\n                        <div class=\"image-wrapper\" mbr-if=\"showImg\">\n                            <img src=\"@PROJECT_PATH@/assets/images/6.jpg-1280x960.jpg\" alt=\"Professional Online Presence\">\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card\" mbr-if=\"cardAmount > 1\">\n                    <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                        <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse2\" aria-expanded=\"false\" aria-controls=\"collapse2\">\n                            <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>2. Fast Delivery – Go Live in 24 Hours</b></h6>\n                            <span class=\"sign mbr-iconfont mobi-mbri-plus\" mbr-if=\"showIcon\"></span>\n                        </a>\n                    </div>\n                    <div id=\"collapse2\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                        <div class=\"panel-body\">\n                            <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                No delays. No follow-ups. Once you upload your CV and payment receipt, we handle the rest. Within 24 hours, your sleek personal site is live and shareable — ready for job applications, LinkedIn bios, or professional pitches. It’s speed, without sacrificing quality.\n                            </p>\n                        </div>\n                        <div class=\"image-wrapper\" mbr-if=\"showImg\">\n                            <img src=\"@PROJECT_PATH@/assets/images/8.jpg-1280x960.jpg\" alt=\"Fast Delivery\">\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card\" mbr-if=\"cardAmount > 2\">\n                    <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                        <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse3\" aria-expanded=\"false\" aria-controls=\"collapse3\">\n                            <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>3. Zero Stress, Zero Tech Skills Needed</b></h6>\n                            <span class=\"sign mbr-iconfont mobi-mbri-plus\" mbr-if=\"showIcon\"></span>\n                        </a>\n                    </div>\n                    <div id=\"collapse3\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                        <div class=\"panel-body\">\n                            <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                No website building. No templates to edit. Just submit your CV and (optional) sample link — and we’ll turn it into a clean, modern website that reflects your personality and professionalism. No technical knowledge required. We do all the heavy lifting.\n                            </p>\n                        </div>\n                        <div class=\"image-wrapper\" mbr-if=\"showImg\">\n                            <img src=\"@PROJECT_PATH@/assets/images/16.jpg-1280x960.jpg\" alt=\"Ne Skills\">\n                        </div>\n                    </div>\n                </div>\n                <div class=\"card\" mbr-if=\"cardAmount > 3\">\n                    <div class=\"card-header\" role=\"tab\" id=\"headingOne\">\n                        <a role=\"button\" class=\"panel-title collapsed\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-core href=\"#collapse4\" aria-expanded=\"false\" aria-controls=\"collapse4\">\n                            <h6 class=\"panel-title-edit mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" data-app-selector=\".panel-title-edit\"><b>4. Unbeatable Price – Just ₦2,500 All-In</b></h6>\n                            <span class=\"sign mbr-iconfont mobi-mbri-plus\" mbr-if=\"showIcon\"></span>\n                        </a>\n                    </div>\n                    <div id=\"collapse4\" class=\"panel-collapse noScroll collapse\" role=\"tabpanel\" aria-labelledby=\"headingOne\" data-parent=\"#accordion\" data-bs-parent=\"#accordion\">\n                        <div class=\"panel-body\">\n                            <p class=\"mbr-fonts-style panel-text\" mbr-theme-style=\"display-7\" data-app-selector=\".panel-text\">\n                                For less than the cost of lunch, you get a live, hosted CV website — fully set up, personalized, and optimized. No subscriptions. No hidden fees. Just a simple one-time payment of ₦2,500 for a tool that can boost your career visibility in a big way.\n                            </p>\n                        </div>\n                        <div class=\"image-wrapper\" mbr-if=\"showImg\">\n                            <img src=\"@PROJECT_PATH@/assets/images/9.jpg-1280x960.jpg\" alt=\"very Cheap\">\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tlJO4FXRhZ",
          "_anchor": "features",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 1rem)",
              "padding-bottom": "(@paddingBottom * 1rem)"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value",
              ".second-bg-color": {
                "position": "absolute",
                "top": "0",
                "left": "0",
                "width": "100%",
                "height": "100%",
                "background-color": "@secondColor",
                "border-top-left-radius": "4.1666666667vw",
                "border-top-right-radius": "4.1666666667vw"
              }
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            "position": "relative",
            ".col-text": {
              "@media (max-width: 991px)": {
                "order": "2",
                "margin-top": "50px"
              },
              "@media (max-width: 767px)": {
                "margin-top": "32px"
              }
            },
            ".col-img": {
              "@media (max-width: 991px)": {
                "order": "1"
              }
            },
            ".text-wrapper": {
              "width": "100%"
            },
            ".mbr-section-title": {
              "color": "#2d2d2d"
            },
            ".mbr-text": {
              "color": "#000000",
              "width": "56%",
              "margin-right": "auto",
              "margin-top": "2rem",
              "@media (max-width: 991px)": {
                "width": "100%"
              },
              "@media (max-width: 767px)": {
                "margin-top": "1.5rem"
              }
            },
            ".mbr-section-btn": {
              "margin-top": "2rem",
              "@media (max-width: 767px)": {
                "margin-top": "1.5rem"
              }
            },
            ".image-wrapper": {
              "border-radius": "32px",
              "overflow": "hidden",
              "& when (@showImgBorder)": {
                "border": "1px solid @ImgBorderColor"
              },
              "img": {
                "width": "100%",
                "object-fit": "cover"
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#000000"
            }
          },
          "_name": "afeatures1",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features1 orderm5\" group=\"Features\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Image Border\" name=\"showImgBorder\" checked>\n        <input type=\"color\" title=\"Image Border Color\" name=\"ImgBorderColor\" value=\"#ffffff\" condition=\"showImgBorder\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#2d2d2d\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@PROJECT_PATH@/assets/images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Second Bg Color\" name=\"secondBgColor\" condition=\"bg.type === 'color'\" checked>\n        <input type=\"color\" title=\"Second Color\" name=\"secondColor\" value=\"#dfe8ff\" condition=\"secondBgColor && bg.type === 'color'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ede7e2\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n    <div class=\"second-bg-color\" mbr-if=\"secondBgColor\"></div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center align-items-end\">\n            <div class=\"col-12 col-lg-7 col-text\">\n                <div class=\"text-wrapper\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">Ready to Stand Out with Your Own CV Website?</h1>\n                    <p class=\"mbr-text mbr-fonts-style mb-0\" mbr-theme-style=\"display-4\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">In just 24 hours, your CV can be transformed into a sleek, personalized website — hosted, styled, and live for the world to see. No stress. No technical steps. Just ₦2,500 and you’re in.<br><br>Why wait to get noticed? Let your career speak louder.</p>\n                    <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn custom-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-iconFont\"><a class=\"btn btn-primary\" href=\"https://tally.so/r/nGae6Z\" data-app-placeholder=\"Type Text\" target=\"_blank\">\n                            <div class=\"btn-transform\"><strong>Get Your Website Now</strong></div>\n                        </a> <a class=\"btn btn-black\" href=\"https://forms.gle/QFnm8kvG9AAdUHATA\" data-app-placeholder=\"Type Text\" target=\"_blank\">\n                            <div class=\"btn-transform\"><strong>Need to a CV!</strong></div>\n                        </a></div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5 col-img\">\n                <div class=\"image-wrapper\">\n                    <img src=\"@PROJECT_PATH@/assets/images/3.jpg-1280x960.jpg\" alt=\"Get Your CV\">\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
