              "overflow": "hidden",
              "aspect-ratio": "(1 / 1)",
              "background-color": "@iconCardBgColor",
              "@media (max-width: 991px)": {
                "width": "19.2vw"
              },
              "@media (max-width: 767px)": {
                "width": "42.67vw"
              },
              ".mbr-iconfont": {
                "font-size": "6vw !important",
                "color": "@iconCardColor",
                "@media (max-width: 991px)": {
                  "font-size": "9.87vw !important"
                },
