          "_name": "aarticle2",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article2 orderm5\" group=\"Article\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"8\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"color\" title=\"Marker Color\" name=\"markerColor\" value=\"#000000\" condition=\"showList\">\n        <input type=\"range\" name=\"countItem\" title=\"Count\" min=\"1\" max=\"6\" value=\"4\" step=\"1\" condition=\"showList\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#dfe8ff\">\n        <input type=\"checkbox\" title=\"Second Bg Color\" name=\"secondBgColor\" checked>\n        <input type=\"color\" title=\"Second Color\" name=\"secondColor\" value=\"#fafafa\" condition=\"secondBgColor\">\n    </mbr-parameters>\n    <div class=\"second-bg-color\" mbr-if=\"secondBgColor\"></div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-4\"><b>Post-Delivery Updates</b></h3>\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">\n                    Risus nec feugiat in fermentum posuere urna nec\n                    tincidunt praesent. Lacus vel facilisis volutpat est velit egestas. Et ligula ullamcorper malesuada\n                    proin libero nunc consequat interdum.\n                </h4>\n                <div class=\"items-container\" mbr-if=\"showList\">\n                    <div class=\"item\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">You are entitled to request minor updates (e.g. contact details, CV version updates).<br></p>\n                    </div>\n                    <div class=\"item\" mbr-if=\"countItem > 1\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            Updates requested within 24 hours of delivery are free.\n                        </p>\n                    </div>\n\n                    <div class=\"item\" mbr-if=\"countItem > 2\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            After 24 hours, all updates or adjustments will incur a service charge of ₦500 per update.\n                        </p>\n                    </div>\n                    <div class=\"item\" mbr-if=\"countItem > 3\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Major redesigns or layout overhauls may require a separate quote.<br></p>\n                    </div>\n                    <div class=\"item\" mbr-if=\"countItem > 4\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            Magna eget est lorem ipsum dolor sit amet consectetur. Nunc mi ipsum faucibus vitae\n                            aliquet nec. Mi quis hendrerit dolor magna eget.\n                        </p>\n                    </div>\n                    <div class=\"item\" mbr-if=\"countItem > 5\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            Gravida arcu ac tortor dignissim convallis aenean. Nibh sed pulvinar proin gravida.\n                            Sem integer vitae justo eget. Urna et pharetra pharetra massa. Lectus urna duis\n                            convallis convallis tellus id interdum.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
