        {
          "alias": false,
          "_styles": {
            "position": "relative",
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "background-color": "@bgColor",
            ".second-bg-color": {
              "position": "absolute",
              "top": "0",
              "left": "0",
              "width": "100%",
              "height": "100%",
              "background-color": "@secondColor",
              "border-top-left-radius": "4.1666666667vw",
              "border-top-right-radius": "4.1666666667vw"
            },
            ".mbr-section-title": {
              "color": "#000000",
              "margin-bottom": "1.736vw",
              "@media (max-width: 991px)": {
                "margin-bottom": "6.66vw"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#000000",
              "margin-bottom": "1.736vw",
              "@media (max-width: 991px)": {
                "margin-bottom": "6.66vw"
              }
            },
            ".items-container": {
              "display": "flex",
              "flex-direction": "column",
              "align-items": "stretch",
              "padding-left": "1.736vw",
              "@media (max-width: 991px)": {
                "padding-left": "6.66vw"
              }
            },
            ".item": {
              "position": "relative",
              "margin-bottom": "0.83vw",
              "@media (max-width: 991px)": {
                "margin-bottom": "3.2vw"
              },
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "top": "8px",
                "left": "-1.4vw",
                "width": "0.6vw",
                "aspect-ratio": "(1 / 1)",
                "border-radius": "50%",
                "background-color": "@markerColor",
                "@media (max-width: 991px)": {
                  "left": "-2.5vw",
                  "width": "1.2vw"
                },
                "@media (max-width: 575px)": {
                  "left": "-2.7vw",
                  "width": "1.6vw"
                }
              }
            },
            ".mbr-text": {
              "color": "#000000"
            }
          },
          "_name": "aarticle2",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article2 orderm5\" group=\"Article\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"8\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"List\" name=\"showList\" checked>\n        <input type=\"color\" title=\"Marker Color\" name=\"markerColor\" value=\"#000000\" condition=\"showList\">\n        <input type=\"range\" name=\"countItem\" title=\"Count\" min=\"1\" max=\"6\" value=\"4\" step=\"1\" condition=\"showList\">\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#fafafa\">\n        <input type=\"checkbox\" title=\"Second Bg Color\" name=\"secondBgColor\" checked>\n        <input type=\"color\" title=\"Second Color\" name=\"secondColor\" value=\"#dfe8ff\" condition=\"secondBgColor\">\n    </mbr-parameters>\n    <div class=\"second-bg-color\" mbr-if=\"secondBgColor\"></div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-4\"><b>How We Use Your Information</b></h3>\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-7\">We use your submitted information solely for the purpose of:</h4>\n                <div class=\"items-container\" mbr-if=\"showList\">\n                    <div class=\"item\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            Creating and publishing your CV website\n                        </p>\n                    </div>\n                    <div class=\"item\" mbr-if=\"countItem > 1\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            Contacting you for updates or delivery status</p>\n                    </div>\n\n                    <div class=\"item\" mbr-if=\"countItem > 2\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            Providing support or customer service\n                        </p>\n                    </div>\n                    <div class=\"item\" mbr-if=\"countItem > 3\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            Improving our service based on feedback<br><br>We do not sell, rent, or share your personal information with any third-party services or marketers.<br>\n                        </p>\n                    </div>\n                    <div class=\"item\" mbr-if=\"countItem > 4\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            Magna eget est lorem ipsum dolor sit amet consectetur. Nunc mi ipsum faucibus vitae\n                            aliquet nec. Mi quis hendrerit dolor magna eget.\n                        </p>\n                    </div>\n                    <div class=\"item\" mbr-if=\"countItem > 5\">\n                        <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">\n                            Gravida arcu ac tortor dignissim convallis aenean. Nibh sed pulvinar proin gravida.\n                            Sem integer vitae justo eget. Urna et pharetra pharetra massa. Lectus urna duis\n                            convallis convallis tellus id interdum.\n                        </p>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
