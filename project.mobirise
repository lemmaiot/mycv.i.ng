          "_name": "aarticle1",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article1 orderm5\" group=\"Article\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"8\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#dfe8ff\">\n        <input type=\"checkbox\" title=\"Second Bg Color\" name=\"secondBgColor\" checked>\n        <input type=\"color\" title=\"Second Color\" name=\"secondColor\" value=\"#fafafa\" condition=\"secondBgColor\">\n    </mbr-parameters>\n    <div class=\"second-bg-color\" mbr-if=\"secondBgColor\"></div>\n    <div class=\"container\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-5\">\n                    PROIN LIBERO\n                </h3>\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-4\"><b>Document Confidentiality</b></h4>\n                <p class=\"mbr-text mbr-fonts-style mb-0\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">Your CV and all submitted files are treated as confidential. They are only accessed by our team to build your website and are never published, shared, or stored publicly without your consent.<br><br>We delete raw CV files after your site is successfully delivered, unless you request long-term update support.<br></p>\n            </div>\n        </div>\n    </div>\n</section>",
