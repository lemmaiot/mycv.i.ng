            },
            ".social-container": {
              "width": "100%",
              "padding-top": "30px",
              "@media (max-width: 991px)": {}
            },
            ".social-title": {
              "color": "#ffffff",
              "margin-bottom": "8px"
            },
            ".social-list": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "margin": "-15px",
              "margin-top": "24px"
            },
            ".soc-item": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative",
              "margin": "15px",
              "min-width": "60px",
              "padding": "10px",
              "aspect-ratio": "(1 / 1)",
              "border-radius": "6px",
              "background": "linear-gradient(145deg, @socialBgColor1, @socialBgColor2)",
              "& when (@socialShadow)": {
                "box-shadow": "10px 10px 19px @socialShadow1, -10px -10px 19px @socialShadow2"
              },
              "transition": "0.4s all",
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "z-index": "4",
                "transition": "0.4s all",
                "width": "100%",
                "height": "100%",
                "border-radius": "5px",
                "background": "linear-gradient(to right bottom, #212428, #16181c)",
                "opacity": "0"
              },
              ".mbr-iconfont": {
                "position": "relative",
                "z-index": "5",
                "transition": "0.4s all",
                "font-size": "22px",
                "color": "@socialColor"
              },
              "&:hover": {
                "transform": "translateY(-3px)",
                ".mbr-iconfont": {
                  "color": "@primaryColor"
                },
                "&:before": {
                  "opacity": "1"
                }
              }
            },
            ".form-main-container": {
              "width": "100%",
              "height": "100%",
              "@media (min-width: 1200px)": {
                "& when not (@reverseContent)": {
                  "padding-left": "20px"
                },
                "& when (@reverseContent)": {
                  "padding-right": "20px"
                }
              }
            },
            ".form-wrap": {
              "width": "100%",
              "height": "100%",
              "padding": "30px",
              "border-radius": "10px",
              "& when (@showFormBg)": {
                "background": "@formBg"
              },
              "& when (@formShadow)": {
                "box-shadow": "10px 10px 19px @formShadowColor1, -10px -10px 19px @formShadowColor2"
              },
              "@media (max-width: 575px)": {
                "padding": "20px"
              }
            },
            "form": {
              "width": "100%",
              ".dragArea.row": {
                "justify-content": "flex-start",
                "width": "auto !important"
              },
              "p": {
                "color": "#878e99"
              },
              ".mbr-section-btn": {
                "text-align": "center",
                "justify-content": "center",
                ".btn": {
                  "width": "100%"
                }
              },
              ".form-group": {
                "margin-bottom": "20px !important"
              },
              ".form-control": {
                "background-color": "#191b1e",
                "border-radius": "6px !important",
                "height": "55px",
                "box-shadow": "1px 4px 2px -3px rgba(0, 0, 0, 0.7) inset, -1px -3px 3px -2px rgba(255, 255, 255, 0.2) inset !important",
                "border": "2px solid #191b1e !important",
                "padding": "10px 15px",
                "font-size": "18px",
                "margin-bottom": "0",
                "color": "#C4CFDE",
                "font-weight": "400",
                "transition": "0.4s all !important",
                "line-height": "29px !important",
                "&::-webkit-input-placeholder": {
                  "color": "#878e99"
                },
                "&::-moz-placeholder": {
                  "color": "#878e99"
                },
                "&:-moz-placeholder": {
                  "color": "#878e99"
                },
                "&:-ms-input-placeholder": {
                  "color": "#878e99"
                }
              },
              "select": {
                "color": "#878e99 !important"
              },
              "textarea": {
                "height": "216px !important",
                "resize": "none"
              },
              "input, textarea": {
                "&:active, &:focus": {
                  "border-color": "@primaryColor !important",
                  "box-shadow": "none !important",
                  "color": "#878e99 !important",
                  "outline": "none !important",
                  "&::-webkit-input-placeholder": {
                    "color": "#878e99"
                  },
                  "&::-moz-placeholder": {
                    "color": "#878e99"
                  },
                  "&:-moz-placeholder": {
                    "color": "#878e99"
                  },
                  "&:-ms-input-placeholder": {
                    "color": "#878e99"
                  }
                }
              },
              ".row": {
                "margin-left": "-15px !important",
                "margin-right": "-15px !important"
              },
              ".row [class*=col]": {
                "padding-left": "15px !important",
                "padding-right": "15px !important"
              },
              "label": {
                "width": "100%",
                "color": "#878e99",
                "margin-bottom": "14px"
              },
              ".form-control-label": {
                "width": "100%"
              },
              ".form-check-label": {
                "margin-bottom": "14px"
              },
              ".form-check-input": {
                "border-color": "#191b1e !important",
                "outline": "none !important",
                "box-shadow": "none !important",
                "background-color": "transparent !important",
                "&:focus, &:hover": {
                  "border-color": "@primaryColor !important"
                }
              },
              ".form-check-input:checked": {
                "border-color": "@primaryColor !important",
                "background-color": "#191b1e !important"
              }
            },
            "LABEL": {
              "color": "#000000"
            }
          },
          "_name": "aform1",
          "_sourceTheme": "expertm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form1 expertm5\" group=\"Forms\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Info Card\" name=\"showCard\" checked>\n        <header condition=\"showCard\">Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked condition=\"showCard\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked condition=\"showCard\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked condition=\"showCard\">\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" condition=\"showCard\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked condition=\"showCard\">\n        <input type=\"checkbox\" title=\"Social Title\" name=\"showSocialTitle\" checked condition=\"showSocial && showCard\">\n        <input type=\"color\" title=\"Social Color\" name=\"socialColor\" value=\"#C4CFDE\" condition=\"showSocial && showCard\">\n        <input type=\"color\" title=\"Social BG Color 1\" name=\"socialBgColor1\" value=\"#1e2024\" condition=\"showSocial && showCard\">\n        <input type=\"color\" title=\"Social BG Color 2\" name=\"socialBgColor2\" value=\"#23272b\" condition=\"showSocial && showCard\">\n        <input type=\"checkbox\" name=\"socialShadow\" title=\"Social Shadow\" checked condition=\"showSocial && showCard\">\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"socialShadow1\" value=\"#2d2d2d\" condition=\"socialShadow && showSocial && showCard\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"socialShadow2\" value=\"#23272B\" condition=\"socialShadow && showSocial && showCard\">\n        <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"6\" step=\"1\" value=\"3\" condition=\"showSocial && showCard\">\n        <header condition=\"showCard\">Card Style</header>\n        <input type=\"checkbox\" title=\"Card BG\" name=\"showCardBg\" condition=\"showCard\" checked>\n        <input type=\"color\" title=\"Card BG Color\" name=\"cardBg\" value=\"#4a90e2\" condition=\"showCard && showCardBg\">\n        <input type=\"checkbox\" name=\"cardShadow\" title=\"Card Shadow\" checked condition=\"showCard\">\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"shadowColor1\" value=\"#2d2d2d\" condition=\"cardShadow && showCard\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"shadowColor2\" value=\"#ffffff\" condition=\"cardShadow && showCard\">\n        <header>Form Style</header>\n        <input type=\"checkbox\" title=\"Form BG\" name=\"showFormBg\">\n        <input type=\"color\" title=\"Form BG Color\" name=\"formBg\" value=\"#212428\" condition=\"showFormBg\">\n        <input type=\"checkbox\" name=\"formShadow\" title=\"Form Shadow\" checked>\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"formShadowColor1\" value=\"#2d2d2d\" condition=\"formShadow\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"formShadowColor2\" value=\"#ffffff\" condition=\"formShadow\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background4.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#fafafa\" selected>\n        </fieldset>\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type!='color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#212428\" condition=\"bg.type!='color' && overlay\">\n        <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"bg.type!='color' && overlay\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"(overlay && bg.type=='image')\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showMainTitle || showMainSubtitle\">\n                <div class=\"mbr-section-head\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                        CONTACT\n                    </h3>\n                    <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                        <b>Contact With Me</b>\n                    </h5>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-lg-4 col-info-card\" mbr-if=\"showCard\">\n                <div class=\"item-card\">\n                    <div class=\"item-wrap\">\n                        <div class=\"card-bg\"></div>\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/features2.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"card-box\" mbr-if=\"showTitle || showSubtitle || showText || showContacts || showSocial\">\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                               <b>Jacob Smith</b>\n                            </h5>\n                            <h6 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                Chief Operating Officer\n                            </h6>\n                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                Pharetra sit amet aliquam id diam maecenas ultricies mi dolor sit amet.\n                            </p>\n                            <p class=\"card-contacts mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showContacts\" data-app-selector=\".card-contacts\">\n                                Phone: <a href=\"#\" class=\"text-warning\">+011 222 343 56</a>\n                                <br>\n                                Email: <a href=\"#\" class=\"text-warning\">admin@expertm5.com</a>\n                            </p>\n                            <div class=\"social-container\" mbr-if=\"showSocial\">\n                                <p class=\"social-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSocialTitle\" data-app-selector=\".social-title\">\n                                    FIND WITH ME\n                                </p>\n                                <div class=\"social-list\">\n                                    <div class=\"soc-item\">\n                                        <span mbr-icon class=\"socicon-twitter socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                    </div>\n                                    <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                                        <span mbr-icon class=\"socicon-facebook socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                    </div>\n                                    <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                                        <span mbr-icon class=\"socicon-instagram socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                    </div>\n                                    <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                                        <span mbr-icon class=\"socicon-youtube socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                    </div>\n                                    <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                                        <span mbr-icon class=\"socicon-behance socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                    </div>\n                                    <div class=\"soc-item\" mbr-if=\"socialCount>5\">\n                                        <span mbr-icon class=\"socicon-vimeo socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-8 col-form\">\n                <div class=\"form-main-container\">\n                    <div class=\"form-wrap\">\n                        <div mbr-form class=\"mbr-form\">\n                            <form action name=\"Form Name\" method=\"POST\" data-rcpha_sitekey=\"\" data-rcpha_secretkey=\"\" class=\"mbr-form form-with-styler mx-auto\">\n                                <div class=\"row\">\n                                    <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">\n                                        Thanks for filling out the form!</div>\n                                    <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">\n                                        Oops...! some problem!\n                                    </div>\n                                </div>\n                                <div class=\"dragArea row\">\n                                    <div class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\" data-for=\"name\">\n                                        <label for=\"name\" class=\"form-control-label mbr-fonts-style display-7\" data-app-edit=\"content\" mbr-static-html=\"uname__104\" mbr-content-edit=\"uname__104\" data-app-placeholder=\"Type Text\" mbr-on-change-component-node=\"uname__105\" mbr-class-var=\"uname__106\" mbr-on-change-theme-style=\"uname__107\" data-class-var=\"display-7\">YOUR NAME</label>\n                                        <input type=\"text\" name=\"name\" data-form-field=\"name\" class=\"form-control display-7\" value mbr-class-var=\"uname__108\" mbr-on-change-theme-style=\"uname__109\" data-class-var=\"display-7\">\n                                    </div>\n                                    <div class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\" data-for=\"phone\">\n                                        <label for=\"phone\" class=\"form-control-label mbr-fonts-style display-7\" data-app-edit=\"content\" mbr-static-html=\"uname__110\" mbr-content-edit=\"uname__110\" data-app-placeholder=\"Type Text\" mbr-on-change-component-node=\"uname__111\" mbr-class-var=\"uname__112\" mbr-on-change-theme-style=\"uname__113\" data-class-var=\"display-7\">PHONE NUMBER</label>\n                                        <input type=\"text\" name=\"phone\" data-form-field=\"phone\" class=\"form-control display-7\" value mbr-class-var=\"uname__114\" mbr-on-change-theme-style=\"uname__115\" data-class-var=\"display-7\">\n                                    </div>\n                                    <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"email\" style>\n                                        <label for=\"email\" class=\"form-control-label mbr-fonts-style display-7\" data-app-edit=\"content\" mbr-static-html=\"uname__116\" mbr-content-edit=\"uname__116\" data-app-placeholder=\"Type Text\" mbr-on-change-component-node=\"uname__117\" mbr-class-var=\"uname__118\" mbr-on-change-theme-style=\"uname__119\" data-class-var=\"display-7\">EMAIL</label>\n                                        <input type=\"email\" name=\"email\" data-form-field=\"email\" class=\"form-control display-7\" value mbr-class-var=\"uname__120\" mbr-on-change-theme-style=\"uname__121\" data-class-var=\"display-7\">\n                                    </div>\n                                    <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"subject\">\n                                        <label for=\"subject\" class=\"form-control-label mbr-fonts-style display-7\" data-app-edit=\"content\" mbr-static-html=\"uname__122\" mbr-content-edit=\"uname__122\" data-app-placeholder=\"Type Text\" mbr-on-change-component-node=\"uname__123\" mbr-class-var=\"uname__124\" mbr-on-change-theme-style=\"uname__125\" data-class-var=\"display-7\">SUBJECT</label>\n                                        <input type=\"text\" name=\"subject\" data-form-field=\"subject\" class=\"form-control display-7\" value mbr-class-var=\"uname__126\" mbr-on-change-theme-style=\"uname__127\" data-class-var=\"display-7\">\n                                    </div>\n                                    <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"textarea\" style>\n                                        <label for=\"textarea\" class=\"form-control-label mbr-fonts-style display-7\" data-app-edit=\"content\" mbr-static-html=\"uname__128\" mbr-content-edit=\"uname__128\" data-app-placeholder=\"Type Text\" mbr-on-change-component-node=\"uname__129\" mbr-class-var=\"uname__130\" mbr-on-change-theme-style=\"uname__131\" data-class-var=\"display-7\">YOUR MESSAGE</label>\n                                        <textarea name=\"textarea\" data-form-field=\"textarea\" class=\"form-control display-7\" mbr-class-var=\"uname__132\" mbr-on-change-theme-style=\"uname__133\" data-class-var=\"display-7\"></textarea>\n                                    </div>\n                                    <div mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" class=\"col-12 align-center mbr-section-btn custom-section-btn\"><a type=\"submit\" class=\"btn btn-success\" data-app-placeholder=\"Type Text\">SEND MESSAGE</a></div>\n                                </div>\n\n\n\n                            </form>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uSwzf95UtT",
          "_anchor": "aform1-13",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            ".mbr-text": {
              "color": "#000000"
            },
            ".media-container-row .mbr-text": {
              "color": "#d8d0ca"
            }
          },
          "_name": "afooter2",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer2 orderm5\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#2d2d2d\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#F5FF7D\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row align-center\">\n            <div class=\"col-12\">\n                <p class=\"mbr-text mb-0 mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".media-container-row .mbr-text\" data-app-placeholder=\"Type Text\">\n                    © Copyright 2025 <a href=\"http://lemmaiot.com.ng\" class=\"text-primary\" target=\"_blank\"><b>LemmaIoT </b></a>- All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uSwzfcSBSH",
          "_anchor": "afooter2-14",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            ".hidden": {
              "display": "none"
            },
            ".witsec-socialbar": {
              "position": "fixed",
              "top": "50%",
              "-webkit-transform": "translateY(-50%)",
              "-ms-transform": "translateY(-50%)",
              "transform": "translateY(-50%)",
              "z-index": "99999"
            },
            ".witsec-socialbar a": {
              "display": "block",
              "text-align": "center",
              "transition": "all 0.3s ease",
              "color": "@iconColor",
              "padding": "unit(@padding, ~'rem')",
              "font-size": "unit(@fontSize, ~'rem')",
              "border-radius": "unit(@borderRadius, ~'%')"
            },
            ".witsec-socialbar .icon": {
              "margin": "unit(@iconSpacing, ~'rem')"
            },
            ".witsec-socialbar a:hover": {
              "background-color": "@hoverColor"
            },
            ".witsec-socialbar .icon1": {
              "background": "@bgColorIcon1",
              "color": "@iconColor"
            },
            ".witsec-socialbar .icon2": {
              "background": "@bgColorIcon2",
              "color": "@iconColor"
            },
            ".witsec-socialbar .icon3": {
              "background": "@bgColorIcon3",
              "color": "@iconColor"
            },
            ".witsec-socialbar .icon4": {
              "background": "@bgColorIcon4",
              "color": "@iconColor"
            },
            ".witsec-socialbar .icon5": {
              "background": "@bgColorIcon5",
              "color": "@iconColor"
            },
            ".witsec-socialbar .icon6": {
              "background": "@bgColorIcon6",
              "color": "@iconColor"
            }
          },
          "_name": "design-block",
          "_customHTML": "<section data-bs-version=\"5.1\">\n\n<mbr-parameters>\n<!-- Block parameters controls (Blue \"Gear\" panel) -->\n<input type=\"range\" inline title=\"Social Icons\" name=\"socialIcons\" min=\"0\" max=\"6\" step=\"1\" value=\"4\">\n<input type=\"range\" inline title=\"Border Radius\" name=\"borderRadius\" min=\"0\" max=\"50\" step=\"10\" value=\"20\">\n<input type=\"range\" inline title=\"Padding\" name=\"padding\" min=\"0\" max=\"2\" step=\"0.1\" value=\"1\">\n<input type=\"range\" inline title=\"Font Size\" name=\"fontSize\" min=\"1\" max=\"4\" step=\"0.2\" value=\"1.4\">\n<input type=\"range\" inline title=\"Icon Spacing\" name=\"iconSpacing\" min=\"0\" max=\"2\" step=\"0.1\" value=\"0.5\">\n<input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#ffffff\">\n<input type=\"color\" title=\"Hover Color\" name=\"hoverColor\" value=\"#232323\">\n<input type=\"color\" title=\"Background Color Icon 1\" name=\"bgColorIcon1\" value=\"#3B5998\">\n<input type=\"color\" title=\"Background Color Icon 2\" name=\"bgColorIcon2\" value=\"#55ACEE\">\n<input type=\"color\" title=\"Background Color Icon 3\" name=\"bgColorIcon3\" value=\"#dd4b39\">\n<input type=\"color\" title=\"Background Color Icon 4\" name=\"bgColorIcon4\" value=\"#007bb5\">\n<input type=\"color\" title=\"Background Color Icon 5\" name=\"bgColorIcon5\" value=\"#bb0000\">\n<input type=\"color\" title=\"Background Color Icon 6\" name=\"bgColorIcon6\" value=\"#232323\">\n<!-- End block parameters -->\n</mbr-parameters>\n\n<div class=\"witsec-socialbar\">\n<a href=\"https://www.facebook.com\" class=\"icon icon1\"><span mbr-icon class=\"socicon socicon-facebook mbr-iconfont mbr-iconfont-btn\"></span></a>\n<a href=\"https://twitter.com\" mbr-if=\"socialIcons > 1\" class=\"icon icon2\"><span mbr-icon class=\"socicon socicon-twitter mbr-iconfont mbr-iconfont-btn\"></span></a>\n<a href=\"https://www.google.com\" mbr-if=\"socialIcons > 2\" class=\"icon icon3\"><span mbr-icon class=\"socicon socicon-googleplus mbr-iconfont mbr-iconfont-btn\"></span></a>\n<a href=\"https://www.linkedin.com\" mbr-if=\"socialIcons > 3\" class=\"icon icon4\"><span mbr-icon class=\"socicon socicon-linkedin mbr-iconfont mbr-iconfont-btn\"></span></a>\n<a href=\"https://www.youtube.com\" mbr-if=\"socialIcons > 4\" class=\"icon icon5\"><span mbr-icon class=\"socicon socicon-youtube mbr-iconfont mbr-iconfont-btn\"></span></a>\n<a href=\"mailto:info@yourdomain.com\" mbr-if=\"socialIcons > 5\" class=\"icon icon6\"><span mbr-icon class=\"socicon socicon-mail mbr-iconfont mbr-iconfont-btn\"></span></a>\n</div>\n\n<div mbr-class=\"{'hidden': isPublish}\" style=\"padding:1rem\">Click the \"gear\" icon to change the layout of the social bar. This text will be removed on preview/publish.</div>\n\n</section>",
          "_sourceTheme": "orderm5",
          "_cid": "uSwzff9kw1",
          "_anchor": "design-block-15",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    },
    "error.html": {
      "settings": {
        "title": "Error Page",
        "order": "2",
        "meta_descr": "Get your CV hosted as a sleek, professional website at just ₦2,500. Submit CV + Payment, and go live within 24hrs!",
        "footer_custom": ""
      },
      "components": [
        {
          "_name": "design-block",
          "_sourceTheme": "orderm5",
          "_styles": {
            "& when not (@fullScreen)": {
              "padding-top": "(@paddingTop * 15px)",
              "padding-bottom": "(@paddingBottom * 15px)"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background": "linear-gradient(45deg, @bg-value, @color2)"
            },
            "H1": {
              "color": "#232323"
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#232323"
            },
            "H3": {
              "color": "#232323"
            }
          },
          "_customHTML": "<section data-bs-version=\"5.1\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{\n         'mbr-fullscreen': fullScreen,\n         'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"9\" step=\"1\" value=\"6\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Show Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Subtitle\" name=\"showSubTitle\" checked>\n        <input type=\"checkbox\" title=\"Show Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\" checked>\n\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value parallax>\n            <input type=\"color\" title=\"Background Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"https://www.youtube.com/watch?v=36YgDDJ7XSc\">\n        </fieldset>        <input type=\"color\" name=\"color2\" title=\"Color2\" value=\"#4a90e2\" condition=\"bg.type=='color'\" selected>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.5\" condition=\"overlay && bg.type !== 'color'\">\n    <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container align-center\">\n        <div class=\"row justify-content-md-center\">\n            <div class=\"mbr-white col-md-10\">\n                <h1 class=\"mbr-section-title mbr-bold pb-3 mbr-fonts-style\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                    Oops!</h1>\n                <h3 class=\"mbr-section-subtitle align-center mbr-light pb-3 mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showSubTitle\">\n                    404 Page Not Found</h3>\n                <p class=\"mbr-text pb-3 mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                    Sorry, the page you are looking for could not be found.</p>\n                <div mbr-buttons mbr-theme-style=\"display-4\" class=\"mbr-section-btn\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\"><a class=\"btn btn-md btn-primary\" href=\"index.html\" data-app-placeholder=\"Type Text\"><span class=\"mbrib-home mbr-iconfont mbr-iconfont-btn\"></span>TAKE ME HOME</a>\n                    <a class=\"btn btn-md btn-white-outline\" href=\"https://wa.me/2347083682007\" data-app-placeholder=\"Type Text\"><span class=\"mbrib-letter mbr-iconfont mbr-iconfont-btn\"></span>CONTACT SUPPORT</a></div>\n            </div>\n        </div>\n    </div>\n    <div mbr-if=\"showArrow\" class=\"mbr-arrow hidden-sm-down\" aria-hidden=\"true\">\n        <a href=\"#next\">\n            <i class=\"mbri-down mbr-iconfont\"></i>\n        </a>\n    </div>\n</section>",
          "_anchor": "design-block-17",
          "_isUserblock": true,
          "_cid": "uT01DduRjV",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            ".mbr-text": {
              "color": "#000000"
            },
            ".media-container-row .mbr-text": {
              "color": "#d8d0ca"
            }
          },
          "_name": "afooter2",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer2 orderm5\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#2d2d2d\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#F5FF7D\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row align-center\">\n            <div class=\"col-12\">\n                <p class=\"mbr-text mb-0 mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".media-container-row .mbr-text\" data-app-placeholder=\"Type Text\">\n                    © Copyright 2025 <a href=\"http://lemmaiot.com.ng\" class=\"text-primary\" target=\"_blank\"><b>LemmaIoT </b></a>- All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uOmybejsuF",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {},
          "_anchor": "afooter2-16"
        }
      ]
    }
  }
}