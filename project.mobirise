          "_name": "apeople4",
          "_sourceTheme": "expertm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"people4 expertm5\" group=\"People\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\" checked>\n        <select title=\"Cards\" name=\"cardsAmount\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\" selected>3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\">5</option>\n            <option value=\"6\">6</option>\n            <option value=\"7\">7</option>\n            <option value=\"8\">8</option>\n        </select>\n        <header>Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Border\" name=\"showBorder\" checked condition=\"showTitle\">\n        <input type=\"color\" title=\"Border Color\" name=\"borderColor\" value=\"#16181c\" condition=\"showBorder && showTitle\">\n        <header>Card Style</header>\n        <input type=\"color\" title=\"Card BG 1\" name=\"cardBg1\" value=\"#1e2024\">\n        <input type=\"color\" title=\"Card BG 2\" name=\"cardBg2\" value=\"#23272b\">\n        <input type=\"checkbox\" name=\"cardShadow\" title=\"Card Shadow\" checked>\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"shadowColor1\" value=\"#191b1f\" condition=\"cardShadow\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"shadowColor2\" value=\"#23272B\" condition=\"cardShadow\">\n        <header>Card Hover</header>\n        <input type=\"color\" title=\"Card BG 1\" name=\"cardHoverBg1\" value=\"#212428\">\n        <input type=\"color\" title=\"Card BG 2\" name=\"cardHoverBg2\" value=\"#16181c\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#2d2d2d\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#212428\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showMainTitle || showMainSubtitle\">\n                <div class=\"mbr-section-head\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                        POPULAR CLIENTS\n                    </h3>\n                    <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                       <b>Awesome Clients</b>\n                    </h5>\n                </div>\n            </div>\n        </div>\n        <div class=\"row card-row {{contentAlign}}\">\n            <div class=\"card col-12 col-sm-6 col-md-4 col-lg-3\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-bg\"></div>\n                    <div class=\"card-box\">\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/1.png\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"text-item\" mbr-if=\"showTitle\">\n                            <h5 class=\"card-title align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                <a href=\"#\" class=\"text-white\">\n                                    Volutpat odio\n                                </a>\n                            </h5>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-sm-6 col-md-4 col-lg-3\" mbr-if=\"cardsAmount > 1\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-bg\"></div>\n                    <div class=\"card-box\">\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/2.png\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"text-item\" mbr-if=\"showTitle\">\n                            <h5 class=\"card-title align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                <a href=\"#\" class=\"text-white\">Rhoncus dolor</a>\n                            </h5>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-sm-6 col-md-4 col-lg-3\" mbr-if=\"cardsAmount > 2\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-bg\"></div>\n                    <div class=\"card-box\">\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/3.png\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"text-item\" mbr-if=\"showTitle\">\n                            <h5 class=\"card-title align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                <a href=\"#\" class=\"text-white\">Mollis nunc</a>\n                            </h5>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-sm-6 col-md-4 col-lg-3\" mbr-if=\"cardsAmount > 3\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-bg\"></div>\n                    <div class=\"card-box\">\n                        <div class=\"item-img\">\n                            <img src=\"@ADDONS_PATH@/expertm5/components/_images/clients/4.png\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"text-item\" mbr-if=\"showTitle\">\n                            <h5 class=\"card-title align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                <a href=\"#\" class=\"text-white\">Fringilla urna</a>\n                            </h5>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-sm-6 col-md-4 col-lg-3\" mbr-if=\"cardsAmount > 4\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-bg\"></div>\n                    <div class=\"card-box\">\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/3.png\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"text-item\" mbr-if=\"showTitle\">\n                            <h5 class=\"card-title align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                <a href=\"#\" class=\"text-white\">Fringilla urna</a>\n                            </h5>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-sm-6 col-md-4 col-lg-3\" mbr-if=\"cardsAmount > 5\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-bg\"></div>\n                    <div class=\"card-box\">\n                        <div class=\"item-img\">\n                            <img src=\"@ADDONS_PATH@/expertm5/components/_images/clients/4.png\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"text-item\" mbr-if=\"showTitle\">\n                            <h5 class=\"card-title align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                <a href=\"#\" class=\"text-white\">Fringilla urna</a>\n                            </h5>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-sm-6 col-md-4 col-lg-3\" mbr-if=\"cardsAmount > 6\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-bg\"></div>\n                    <div class=\"card-box\">\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/1.png\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"text-item\" mbr-if=\"showTitle\">\n                            <h5 class=\"card-title align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                <a href=\"#\" class=\"text-white\">Fringilla urna</a>\n                            </h5>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"card col-12 col-sm-6 col-md-4 col-lg-3\" mbr-if=\"cardsAmount > 7\">\n                <div class=\"card-wrapper\">\n                    <div class=\"card-bg\"></div>\n                    <div class=\"card-box\">\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/2.png\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"text-item\" mbr-if=\"showTitle\">\n                            <h5 class=\"card-title align-center mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                                <a href=\"#\" class=\"text-white\">Fringilla urna</a>\n                            </h5>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uShsKG1pLg",
          "_anchor": "apeople4-x",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            ".mbr-overlay": {
              "background-color": "@overlayColor",
              "opacity": "@overlayOpacity"
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            ".container": {
              "padding-left": "10px",
              "padding-right": "10px"
            },
            ".row": {
              "margin-left": "-10px",
              "margin-right": "-10px",
              "flex-wrap": "wrap",
              "align-items": "stretch",
              "& when (@reverseContent)": {
                "flex-direction": "row-reverse"
              },
              "> [class*=\"col\"]": {
                "padding-left": "10px",
                "padding-right": "10px"
              }
            },
            ".col-info-card": {
              "@media (max-width: 991px)": {
                "margin-bottom": "50px"
              }
            },
            ".mbr-section-head": {
              "width": "100%",
              "padding-bottom": "40px"
            },
            ".mbr-section-title": {
              "color": "#ff9b8d",
              "@media (max-width: 767px)": {
                "text-align": "center"
              }
            },
            ".mbr-section-subtitle": {
              "color": "#C4CFDE",
              "margin-top": "15px",
              "@media (max-width: 767px)": {
                "margin-top": "10px",
                "text-align": "center"
              }
            },
            ".item-card": {
              "height": "100%"
            },
            ".item-wrap": {
              "position": "relative",
              "height": "100%",
              "width": "100%",
              "padding": "30px",
              "border-radius": "10px",
              "overflow": "hidden",
              "& when (@showCardBg)": {
                "background": "@cardBg"
              },
              "& when (@cardShadow)": {
                "box-shadow": "10px 10px 19px @shadowColor1, -10px -10px 19px @shadowColor2"
              },
              "@media (max-width: 767px)": {
                "padding": "50px 20px"
              },
              "&:hover": {
                ".item-img": {
                  "img": {
                    "transform": "scale(1.1)"
                  }
                }
              }
            },
            ".item-img": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "width": "100%",
              "border-radius": "10px",
              "overflow": "hidden",
              "img": {
                "width": "100%",
                "aspect-ratio": "(115 / 72)",
                "object-fit": "cover",
                "transition": "0.4s all"
              }
            },
            ".card-box": {
              "padding-top": "28px"
            },
            ".card-title": {
              "color": "#C4CFDE",
              "margin-bottom": "9px"
            },
            ".card-subtitle": {
              "color": "#878e99",
              "margin-bottom": "15px"
            },
            ".card-text": {
              "color": "#878e99",
              "margin-bottom": "20px"
            },
            ".card-contacts": {
              "color": "#878e99",
              "a": {
                "position": "relative",
                "transition": "0.4s all",
                "&:before": {
                  "content": "\"\"",
                  "position": "absolute",
                  "bottom": "0",
                  "left": "0",
                  "width": "0",
                  "height": "1px",
                  "background-color": "@primaryColor",
                  "transition": "0.4s all"
                },
                "&:hover": {
                  "color": "@primaryColor !important",
                  "&:before": {
                    "width": "100%"
                  }
                }
              }
            },
            ".social-container": {
              "width": "100%",
              "padding-top": "30px",
              "@media (max-width: 991px)": {}
            },
            ".social-title": {
              "color": "#C4CFDE",
              "margin-bottom": "8px"
            },
            ".social-list": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "margin": "-15px",
              "margin-top": "24px"
            },
            ".soc-item": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative",
              "margin": "15px",
              "min-width": "60px",
              "padding": "10px",
              "aspect-ratio": "(1 / 1)",
              "border-radius": "6px",
              "background": "linear-gradient(145deg, @socialBgColor1, @socialBgColor2)",
              "& when (@socialShadow)": {
                "box-shadow": "10px 10px 19px @socialShadow1, -10px -10px 19px @socialShadow2"
              },
              "transition": "0.4s all",
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "z-index": "4",
                "transition": "0.4s all",
                "width": "100%",
                "height": "100%",
                "border-radius": "5px",
                "background": "linear-gradient(to right bottom, #212428, #16181c)",
                "opacity": "0"
              },
              ".mbr-iconfont": {
                "position": "relative",
                "z-index": "5",
                "transition": "0.4s all",
                "font-size": "22px",
                "color": "@socialColor"
              },
              "&:hover": {
                "transform": "translateY(-3px)",
                ".mbr-iconfont": {
                  "color": "@primaryColor"
                },
                "&:before": {
                  "opacity": "1"
                }
              }
            },
            ".form-main-container": {
              "width": "100%",
              "height": "100%",
              "@media (min-width: 1200px)": {
                "& when not (@reverseContent)": {
                  "padding-left": "20px"
                },
                "& when (@reverseContent)": {
                  "padding-right": "20px"
                }
              }
            },
            ".form-wrap": {
              "width": "100%",
              "height": "100%",
              "padding": "30px",
              "border-radius": "10px",
              "& when (@showFormBg)": {
                "background": "@formBg"
              },
              "& when (@formShadow)": {
                "box-shadow": "10px 10px 19px @formShadowColor1, -10px -10px 19px @formShadowColor2"
              },
              "@media (max-width: 575px)": {
                "padding": "20px"
              }
            },
            "form": {
              "width": "100%",
              ".dragArea.row": {
                "justify-content": "flex-start",
                "width": "auto !important"
              },
              "p": {
                "color": "#878e99"
              },
              ".mbr-section-btn": {
                "text-align": "center",
                "justify-content": "center",
                ".btn": {
                  "width": "100%"
                }
              },
              ".form-group": {
                "margin-bottom": "20px !important"
              },
              ".form-control": {
                "background-color": "#191b1e",
                "border-radius": "6px !important",
                "height": "55px",
                "box-shadow": "1px 4px 2px -3px rgba(0, 0, 0, 0.7) inset, -1px -3px 3px -2px rgba(255, 255, 255, 0.2) inset !important",
                "border": "2px solid #191b1e !important",
                "padding": "10px 15px",
                "font-size": "18px",
                "margin-bottom": "0",
                "color": "#C4CFDE",
                "font-weight": "400",
                "transition": "0.4s all !important",
                "line-height": "29px !important",
                "&::-webkit-input-placeholder": {
                  "color": "#878e99"
                },
                "&::-moz-placeholder": {
                  "color": "#878e99"
                },
                "&:-moz-placeholder": {
                  "color": "#878e99"
                },
                "&:-ms-input-placeholder": {
                  "color": "#878e99"
                }
              },
              "select": {
                "color": "#878e99 !important"
              },
              "textarea": {
                "height": "216px !important",
                "resize": "none"
              },
              "input, textarea": {
                "&:active, &:focus": {
                  "border-color": "@primaryColor !important",
                  "box-shadow": "none !important",
                  "color": "#878e99 !important",
                  "outline": "none !important",
                  "&::-webkit-input-placeholder": {
                    "color": "#878e99"
                  },
                  "&::-moz-placeholder": {
                    "color": "#878e99"
                  },
                  "&:-moz-placeholder": {
                    "color": "#878e99"
                  },
                  "&:-ms-input-placeholder": {
                    "color": "#878e99"
                  }
                }
              },
              ".row": {
                "margin-left": "-15px !important",
                "margin-right": "-15px !important"
              },
              ".row [class*=col]": {
                "padding-left": "15px !important",
                "padding-right": "15px !important"
              },
              "label": {
                "width": "100%",
                "color": "#878e99",
                "margin-bottom": "14px"
              },
              ".form-control-label": {
                "width": "100%"
              },
              ".form-check-label": {
                "margin-bottom": "14px"
              },
              ".form-check-input": {
                "border-color": "#191b1e !important",
                "outline": "none !important",
                "box-shadow": "none !important",
                "background-color": "transparent !important",
                "&:focus, &:hover": {
                  "border-color": "@primaryColor !important"
                }
              },
              ".form-check-input:checked": {
                "border-color": "@primaryColor !important",
                "background-color": "#191b1e !important"
              }
            }
          },
          "_name": "aform1",
          "_sourceTheme": "expertm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"form1 expertm5\" group=\"Forms\" plugins=\"formstyler, datepicker\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\">Left</option>\n            <option value=\"justify-content-center\" selected>Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Info Card\" name=\"showCard\" checked>\n        <header condition=\"showCard\">Card</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked condition=\"showCard\">\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked condition=\"showCard\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked condition=\"showCard\">\n        <input type=\"checkbox\" title=\"Contacts\" name=\"showContacts\" checked condition=\"showCard\">\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked condition=\"showCard\">\n        <input type=\"checkbox\" title=\"Social Title\" name=\"showSocialTitle\" checked condition=\"showSocial && showCard\">\n        <input type=\"color\" title=\"Social Color\" name=\"socialColor\" value=\"#C4CFDE\" condition=\"showSocial && showCard\">\n        <input type=\"color\" title=\"Social BG Color 1\" name=\"socialBgColor1\" value=\"#1e2024\" condition=\"showSocial && showCard\">\n        <input type=\"color\" title=\"Social BG Color 2\" name=\"socialBgColor2\" value=\"#23272b\" condition=\"showSocial && showCard\">\n        <input type=\"checkbox\" name=\"socialShadow\" title=\"Social Shadow\" checked condition=\"showSocial && showCard\">\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"socialShadow1\" value=\"#191b1f\" condition=\"socialShadow && showSocial && showCard\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"socialShadow2\" value=\"#23272B\" condition=\"socialShadow && showSocial && showCard\">\n        <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"6\" step=\"1\" value=\"3\" condition=\"showSocial && showCard\">\n        <header condition=\"showCard\">Card Style</header>\n        <input type=\"checkbox\" title=\"Card BG\" name=\"showCardBg\" condition=\"showCard\">\n        <input type=\"color\" title=\"Card BG Color\" name=\"cardBg\" value=\"#212428\" condition=\"showCard && showCardBg\">\n        <input type=\"checkbox\" name=\"cardShadow\" title=\"Card Shadow\" checked condition=\"showCard\">\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"shadowColor1\" value=\"#191b1f\" condition=\"cardShadow && showCard\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"shadowColor2\" value=\"#23272B\" condition=\"cardShadow && showCard\">\n        <header>Form Style</header>\n        <input type=\"checkbox\" title=\"Form BG\" name=\"showFormBg\">\n        <input type=\"color\" title=\"Form BG Color\" name=\"formBg\" value=\"#212428\" condition=\"showFormBg\">\n        <input type=\"checkbox\" name=\"formShadow\" title=\"Form Shadow\" checked>\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"formShadowColor1\" value=\"#191b1f\" condition=\"formShadow\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"formShadowColor2\" value=\"#23272B\" condition=\"formShadow\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background4.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#2d2d2d\" selected>\n        </fieldset>\n\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type!='color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#212428\" condition=\"bg.type!='color' && overlay\">\n        <input type=\"range\" inline title=\"Overlay Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.2\" condition=\"bg.type!='color' && overlay\">\n    </mbr-parameters>\n    <div class=\"mbr-overlay\" mbr-if=\"(overlay && bg.type=='image')\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showMainTitle || showMainSubtitle\">\n                <div class=\"mbr-section-head\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                        CONTACT\n                    </h3>\n                    <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                        <b>Contact With Me</b>\n                    </h5>\n                </div>\n            </div>\n        </div>\n\n        <div class=\"row {{contentAlign}}\">\n            <div class=\"col-12 col-lg-4 col-info-card\" mbr-if=\"showCard\">\n                <div class=\"item-card\">\n                    <div class=\"item-wrap\">\n                        <div class=\"card-bg\"></div>\n                        <div class=\"item-img\">\n                            <img src=\"@PROJECT_PATH@/assets/images/features2.jpg\" alt=\"Mobirise Website Builder\">\n                        </div>\n                        <div class=\"card-box\" mbr-if=\"showTitle || showSubtitle || showText || showContacts || showSocial\">\n                            <h5 class=\"card-title mbr-fonts-style\" mbr-theme-style=\"display-5\" mbr-if=\"showTitle\" data-app-selector=\".card-title\">\n                               <b>Jacob Smith</b>\n                            </h5>\n                            <h6 class=\"card-subtitle mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSubtitle\" data-app-selector=\".card-subtitle\">\n                                Chief Operating Officer\n                            </h6>\n                            <p class=\"card-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".card-text\">\n                                Pharetra sit amet aliquam id diam maecenas ultricies mi dolor sit amet.\n                            </p>\n                            <p class=\"card-contacts mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showContacts\" data-app-selector=\".card-contacts\">\n                                Phone: <a href=\"#\" class=\"text-white\">+011 222 343 56</a>\n                                <br>\n                                Email: <a href=\"#\" class=\"text-white\">admin@expertm5.com</a>\n                            </p>\n                            <div class=\"social-container\" mbr-if=\"showSocial\">\n                                <p class=\"social-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSocialTitle\" data-app-selector=\".social-title\">\n                                    FIND WITH ME\n                                </p>\n                                <div class=\"social-list\">\n                                    <div class=\"soc-item\">\n                                        <span mbr-icon class=\"socicon-twitter socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                    </div>\n                                    <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                                        <span mbr-icon class=\"socicon-facebook socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                    </div>\n                                    <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                                        <span mbr-icon class=\"socicon-instagram socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                    </div>\n                                    <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                                        <span mbr-icon class=\"socicon-youtube socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                    </div>\n                                    <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                                        <span mbr-icon class=\"socicon-behance socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                    </div>\n                                    <div class=\"soc-item\" mbr-if=\"socialCount>5\">\n                                        <span mbr-icon class=\"socicon-vimeo socicon mbr-iconfont mbr-iconfont-social\"></span>\n                                    </div>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"col-12 col-lg-8 col-form\">\n                <div class=\"form-main-container\">\n                    <div class=\"form-wrap\">\n                        <div mbr-form class=\"mbr-form\">\n                            <form action name=\"Form Name\" method=\"POST\" data-rcpha_sitekey=\"\" data-rcpha_secretkey=\"\" class=\"mbr-form form-with-styler mx-auto\">\n                                <div class=\"row\">\n                                    <div hidden=\"hidden\" data-form-alert class=\"alert alert-success col-12\">\n                                        Thanks for filling out the form!</div>\n                                    <div hidden=\"hidden\" data-form-alert-danger class=\"alert alert-danger col-12\">\n                                        Oops...! some problem!\n                                    </div>\n                                </div>\n                                <div class=\"dragArea row\">\n                                    <div class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\" data-for=\"name\">\n                                        <label for=\"name\" class=\"form-control-label mbr-fonts-style display-7\" data-app-edit=\"content\" mbr-static-html=\"uname__104\" mbr-content-edit=\"uname__104\" data-app-placeholder=\"Type Text\" mbr-on-change-component-node=\"uname__105\" mbr-class-var=\"uname__106\" mbr-on-change-theme-style=\"uname__107\" data-class-var=\"display-7\">YOUR NAME</label>\n                                        <input type=\"text\" name=\"name\" data-form-field=\"name\" class=\"form-control display-7\" value mbr-class-var=\"uname__108\" mbr-on-change-theme-style=\"uname__109\" data-class-var=\"display-7\">\n                                    </div>\n                                    <div class=\"col-lg-6 col-md-12 col-sm-12 form-group mb-3\" data-for=\"phone\">\n                                        <label for=\"phone\" class=\"form-control-label mbr-fonts-style display-7\" data-app-edit=\"content\" mbr-static-html=\"uname__110\" mbr-content-edit=\"uname__110\" data-app-placeholder=\"Type Text\" mbr-on-change-component-node=\"uname__111\" mbr-class-var=\"uname__112\" mbr-on-change-theme-style=\"uname__113\" data-class-var=\"display-7\">PHONE NUMBER</label>\n                                        <input type=\"text\" name=\"phone\" data-form-field=\"phone\" class=\"form-control display-7\" value mbr-class-var=\"uname__114\" mbr-on-change-theme-style=\"uname__115\" data-class-var=\"display-7\">\n                                    </div>\n                                    <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"email\" style>\n                                        <label for=\"email\" class=\"form-control-label mbr-fonts-style display-7\" data-app-edit=\"content\" mbr-static-html=\"uname__116\" mbr-content-edit=\"uname__116\" data-app-placeholder=\"Type Text\" mbr-on-change-component-node=\"uname__117\" mbr-class-var=\"uname__118\" mbr-on-change-theme-style=\"uname__119\" data-class-var=\"display-7\">EMAIL</label>\n                                        <input type=\"email\" name=\"email\" data-form-field=\"email\" class=\"form-control display-7\" value mbr-class-var=\"uname__120\" mbr-on-change-theme-style=\"uname__121\" data-class-var=\"display-7\">\n                                    </div>\n                                    <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"subject\">\n                                        <label for=\"subject\" class=\"form-control-label mbr-fonts-style display-7\" data-app-edit=\"content\" mbr-static-html=\"uname__122\" mbr-content-edit=\"uname__122\" data-app-placeholder=\"Type Text\" mbr-on-change-component-node=\"uname__123\" mbr-class-var=\"uname__124\" mbr-on-change-theme-style=\"uname__125\" data-class-var=\"display-7\">SUBJECT</label>\n                                        <input type=\"text\" name=\"subject\" data-form-field=\"subject\" class=\"form-control display-7\" value mbr-class-var=\"uname__126\" mbr-on-change-theme-style=\"uname__127\" data-class-var=\"display-7\">\n                                    </div>\n                                    <div class=\"col-lg-12 col-md-12 col-sm-12 form-group mb-3\" data-for=\"textarea\" style>\n                                        <label for=\"textarea\" class=\"form-control-label mbr-fonts-style display-7\" data-app-edit=\"content\" mbr-static-html=\"uname__128\" mbr-content-edit=\"uname__128\" data-app-placeholder=\"Type Text\" mbr-on-change-component-node=\"uname__129\" mbr-class-var=\"uname__130\" mbr-on-change-theme-style=\"uname__131\" data-class-var=\"display-7\">YOUR MESSAGE</label>\n                                        <textarea name=\"textarea\" data-form-field=\"textarea\" class=\"form-control display-7\" mbr-class-var=\"uname__132\" mbr-on-change-theme-style=\"uname__133\" data-class-var=\"display-7\"></textarea>\n                                    </div>\n                                    <div mbr-buttons=\"true\" mbr-theme-style=\"display-7\" data-toolbar=\"-mbrBtnMove,-mbrLink,-mbrBtnRemove,-mbrBtnAdd\" class=\"col-12 align-center mbr-section-btn custom-section-btn\"><a type=\"submit\" class=\"btn btn-success\" data-app-placeholder=\"Type Text\">SEND MESSAGE</a></div>\n                                </div>\n\n\n\n                            </form>\n                        </div>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uShsOkNyr8",
          "_anchor": "aform1-y",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = 'color')": {
              "background-color": "@bg-value"
            },
            "overflow": "hidden",
            ".mbr-text": {
              "color": "#000000"
            },
            ".media-container-row .mbr-text": {
              "color": "#d8d0ca"
            }
          },
          "_name": "afooter2",
          "_sourceTheme": "orderm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"footer2 orderm5\" group=\"Footers\" global once=\"footers\" mbr-class=\"{'mbr-reveal': reveal, 'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"8\" step=\"1\" value=\"2\">\n        <input type=\"checkbox\" title=\"Reveal effect\" name=\"reveal\" checked>\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@THEME_PATH@/components/_images/background3.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#2d2d2d\" selected>\n        </fieldset>\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#F5FF7D\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.6\" condition=\"overlay && bg.type !== 'color'\">\n        <!-- End block parameters -->\n    </mbr-parameters>\n\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div class=\"container\">\n        <div class=\"media-container-row align-center\">\n            <div class=\"col-12\">\n                <p class=\"mbr-text mb-0 mbr-fonts-style align-center\" mbr-theme-style=\"display-7\" data-app-selector=\".media-container-row .mbr-text\" data-app-placeholder=\"Type Text\">\n                    © Copyright 2025 <a href=\"http://lemmaiot.com.ng\" class=\"text-primary\" target=\"_blank\"><b>LemmaIoT </b></a>- All Rights Reserved\n                </p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "tlJSdPfCNW",
          "_anchor": "afooter2-t",
          "_protectedParams": [],
          "_global": true,
          "_once": "footers",
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            ".hidden": {
              "display": "none"
            },
            ".witsec-socialbar": {
              "position": "fixed",
              "top": "50%",
              "-webkit-transform": "translateY(-50%)",
              "-ms-transform": "translateY(-50%)",
              "transform": "translateY(-50%)",
              "z-index": "99999"
            },
            ".witsec-socialbar a": {
              "display": "block",
              "text-align": "center",
              "transition": "all 0.3s ease",
              "color": "@iconColor",
              "padding": "unit(@padding, ~'rem')",
              "font-size": "unit(@fontSize, ~'rem')",
              "border-radius": "unit(@borderRadius, ~'%')"
            },
            ".witsec-socialbar .icon": {
              "margin": "unit(@iconSpacing, ~'rem')"
            },
            ".witsec-socialbar a:hover": {
              "background-color": "@hoverColor"
            },
            ".witsec-socialbar .icon1": {
              "background": "@bgColorIcon1",
              "color": "@iconColor"
            },
            ".witsec-socialbar .icon2": {
              "background": "@bgColorIcon2",
              "color": "@iconColor"
            },
            ".witsec-socialbar .icon3": {
              "background": "@bgColorIcon3",
              "color": "@iconColor"
            },
            ".witsec-socialbar .icon4": {
              "background": "@bgColorIcon4",
              "color": "@iconColor"
            },
            ".witsec-socialbar .icon5": {
              "background": "@bgColorIcon5",
              "color": "@iconColor"
            },
            ".witsec-socialbar .icon6": {
              "background": "@bgColorIcon6",
              "color": "@iconColor"
            }
          },
          "_name": "design-block",
          "_customHTML": "<section data-bs-version=\"5.1\">\n\n<mbr-parameters>\n<!-- Block parameters controls (Blue \"Gear\" panel) -->\n<input type=\"range\" inline title=\"Social Icons\" name=\"socialIcons\" min=\"0\" max=\"6\" step=\"1\" value=\"4\">\n<input type=\"range\" inline title=\"Border Radius\" name=\"borderRadius\" min=\"0\" max=\"50\" step=\"10\" value=\"20\">\n<input type=\"range\" inline title=\"Padding\" name=\"padding\" min=\"0\" max=\"2\" step=\"0.1\" value=\"1\">\n<input type=\"range\" inline title=\"Font Size\" name=\"fontSize\" min=\"1\" max=\"4\" step=\"0.2\" value=\"1.4\">\n<input type=\"range\" inline title=\"Icon Spacing\" name=\"iconSpacing\" min=\"0\" max=\"2\" step=\"0.1\" value=\"0.5\">\n<input type=\"color\" title=\"Icon Color\" name=\"iconColor\" value=\"#ffffff\">\n<input type=\"color\" title=\"Hover Color\" name=\"hoverColor\" value=\"#000000\">\n<input type=\"color\" title=\"Background Color Icon 1\" name=\"bgColorIcon1\" value=\"#3B5998\">\n<input type=\"color\" title=\"Background Color Icon 2\" name=\"bgColorIcon2\" value=\"#55ACEE\">\n<input type=\"color\" title=\"Background Color Icon 3\" name=\"bgColorIcon3\" value=\"#dd4b39\">\n<input type=\"color\" title=\"Background Color Icon 4\" name=\"bgColorIcon4\" value=\"#007bb5\">\n<input type=\"color\" title=\"Background Color Icon 5\" name=\"bgColorIcon5\" value=\"#bb0000\">\n<input type=\"color\" title=\"Background Color Icon 6\" name=\"bgColorIcon6\" value=\"#232323\">\n<!-- End block parameters -->\n</mbr-parameters>\n\n<div class=\"witsec-socialbar\">\n<a href=\"https://www.facebook.com\" class=\"icon icon1\"><span mbr-icon class=\"socicon socicon-facebook mbr-iconfont mbr-iconfont-btn\"></span></a>\n<a href=\"https://twitter.com\" mbr-if=\"socialIcons > 1\" class=\"icon icon2\"><span mbr-icon class=\"socicon socicon-twitter mbr-iconfont mbr-iconfont-btn\"></span></a>\n<a href=\"https://www.google.com\" mbr-if=\"socialIcons > 2\" class=\"icon icon3\"><span mbr-icon class=\"socicon socicon-googleplus mbr-iconfont mbr-iconfont-btn\"></span></a>\n<a href=\"https://www.linkedin.com\" mbr-if=\"socialIcons > 3\" class=\"icon icon4\"><span mbr-icon class=\"socicon socicon-linkedin mbr-iconfont mbr-iconfont-btn\"></span></a>\n<a href=\"https://www.youtube.com\" mbr-if=\"socialIcons > 4\" class=\"icon icon5\"><span mbr-icon class=\"socicon socicon-youtube mbr-iconfont mbr-iconfont-btn\"></span></a>\n<a href=\"mailto:info@yourdomain.com\" mbr-if=\"socialIcons > 5\" class=\"icon icon6\"><span mbr-icon class=\"socicon socicon-mail mbr-iconfont mbr-iconfont-btn\"></span></a>\n</div>\n\n<div mbr-class=\"{'hidden': isPublish}\" style=\"padding:1rem\">Click the \"gear\" icon to change the layout of the social bar. This text will be removed on preview/publish.</div>\n\n</section>",
          "_cid": "lpbAfkeYJL",
          "_anchor": "design-block-lpbAfkeYJL",
          "_sourceTheme": "orderm5",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    },
    "profile_wht.html": {
      "settings": {
        "title": "Personal Profile White",
        "order": "4",
        "meta_descr": "",
        "socialSharingUrl": "",
        "meta_image": "@PROJECT_PATH@/assets/images/social-media-tag-design.jpg-1200x630.jpg"
      },
      "components": [
        {
          "_name": "aheader8",
          "_sourceTheme": "expertm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"header8 expertm5\" group=\"Headers\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <input type=\"checkbox\" title=\"Buttons\" name=\"showButtons\" checked>\n        <input type=\"checkbox\" title=\"Social\" name=\"showSocial\" checked>\n        <header condition=\"showSocial\">Social</header>\n        <select title=\"Icons Align\" name=\"contentAlign\" condition=\"showSocial\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <input type=\"checkbox\" title=\"Social Title\" name=\"showSocialTitle\" condition=\"showSocial\" checked>\n        <input type=\"color\" title=\"Social Color\" name=\"socialColor\" value=\"#C4CFDE\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social BG Color 1\" name=\"socialBgColor1\" value=\"#4a90e2\" condition=\"showSocial\">\n        <input type=\"color\" title=\"Social BG Color 2\" name=\"socialBgColor2\" value=\"#23272b\" condition=\"showSocial\">\n        <input type=\"checkbox\" name=\"socialShadow\" title=\"Social Shadow\" checked condition=\"showSocial\">\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"socialShadow1\" value=\"#191b1f\" condition=\"socialShadow && showSocial\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"socialShadow2\" value=\"#23272B\" condition=\"socialShadow && showSocial\">\n        <input type=\"range\" name=\"socialCount\" title=\"Social Count\" min=\"1\" max=\"6\" step=\"1\" value=\"3\" condition=\"showSocial\">\n        <header>Image</header>\n        <input type=\"checkbox\" name=\"imgBg\" title=\"Image BG\" checked>\n        <input type=\"color\" title=\"Image BG 1\" name=\"cardBg1\" value=\"#c5d4fe\" condition=\"imgBg\">\n        <input type=\"color\" title=\"Image BG 2\" name=\"cardBg2\" value=\"#ff9b8d\" condition=\"imgBg\">\n        <input type=\"checkbox\" name=\"cardShadow\" title=\"Image Shadow\">\n        <input type=\"color\" title=\"Shadow Color 1\" name=\"shadowColor1\" value=\"#232323\" condition=\"cardShadow\">\n        <input type=\"color\" title=\"Shadow Color 2\" name=\"shadowColor2\" value=\"#232323\" condition=\"cardShadow\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background2.jpg\" parallax>\n            <input type=\"color\" title=\"Color\" value=\"#fafafa\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background2.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#212428\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\"></div>\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center align-items-center\">\n            <div class=\"col-12 col-lg-7 col-text\">\n                <div class=\"text-wrapper\">\n                    <h1 class=\"mbr-section-title mbr-fonts-style\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-7\" mbr-if=\"showTitle\">\n                        WELCOME TO MY WORLD\n                    </h1>\n                    <h1 class=\"mbr-section-subtitle mbr-fonts-style\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-2\" mbr-if=\"showSubtitle\">\n                        <b>Hi, I’m <a href=\"#\" class=\"text-danger\">Agata Davis</a><br>\n                            a Photographer.</b>\n                    </h1>\n                    <p class=\"mbr-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">\n                        Cursus vitae congue mauris rhoncus aenean vel elit scelerisque. Risus pretium quam vulputate\n                        dignissim suspendisse in auctor mauris augue, et necessitatibus adipisci.\n                    </p>\n                    <div mbr-buttons mbr-theme-style=\"display-7\" class=\"mbr-section-btn custom-section-btn\" mbr-if=\"showButtons\"><a class=\"btn btn-danger\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n                            DOWNLOAD MY CV\n                        </a></div>\n                    <div class=\"social-container\" mbr-if=\"showSocial\">\n                        <p class=\"social-title mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showSocialTitle\" data-app-selector=\".social-title\">\n                            FIND WITH ME\n                        </p>\n                        <div class=\"social-list {{contentAlign}}\">\n                            <div class=\"soc-item\" mbr-if=\"socialCount>0\">\n                                <span mbr-icon class=\"socicon-twitter socicon mbr-iconfont mbr-iconfont-social\"></span>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>1\">\n                                <span mbr-icon class=\"socicon-facebook socicon mbr-iconfont mbr-iconfont-social\"></span>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>2\">\n                                <span mbr-icon class=\"socicon-instagram socicon mbr-iconfont mbr-iconfont-social\"></span>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>3\">\n                                <span mbr-icon class=\"socicon-youtube socicon mbr-iconfont mbr-iconfont-social\"></span>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>4\">\n                                <span mbr-icon class=\"socicon-behance socicon mbr-iconfont mbr-iconfont-social\"></span>\n                            </div>\n                            <div class=\"soc-item\" mbr-if=\"socialCount>5\">\n                                <span mbr-icon class=\"socicon-vimeo socicon mbr-iconfont mbr-iconfont-social\"></span>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-5 col-img\">\n                <div class=\"img-wrapper\">\n                    <div class=\"img-box\">\n                        <img src=\"@PROJECT_PATH@/assets/images/gallery20.jpg\" alt=\"Mobirise Website Builder\">\n                    </div>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "overflow": "hidden",
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)"
            },
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            ".mbr-fallback-image.disabled": {
              "display": "none"
            },
            ".mbr-fallback-image": {
              "display": "block",
              "background-size": "cover",
              "background-position": "center center",
              "width": "100%",
              "height": "100%",
              "position": "absolute",
              "top": "0",
              "& when (@bg-type = 'video')": {
                "background-image": "url(@fallBackImage)"
              }
            },
            "& when (@reverseContent)": {
              ".row": {
                "flex-direction": "row-reverse"
              }
            },
            ".container": {
              "padding-left": "10px",
              "padding-right": "10px"
            },
            ".row": {
              "margin-left": "-10px",
              "margin-right": "-10px",
              "justify-content": "center",
              "> [class*=\"col\"]": {
                "padding-left": "10px",
                "padding-right": "10px"
              }
            },
            ".col-img": {
              "padding": "10px",
              "@media (min-width: 992px)": {
                "& when not (@reverseContent)": {
                  "padding-left": "30px !important"
                },
                "& when (@reverseContent)": {
                  "padding-right": "30px !important"
                }
              },
              "@media (max-width: 991px) and (min-width: 767px)": {
                "padding": "30px !important"
              }
            },
            ".col-text": {
              "display": "flex",
              "align-items": "center",
              "padding": "10px"
            },
            ".text-wrapper": {
              "width": "100%",
              "@media (max-width: 991px)": {
                "margin-bottom": "30px"
              }
            },
            ".mbr-section-title": {
              "color": "#f55e4a",
              "margin-bottom": "20px"
            },
            ".mbr-section-subtitle": {
              "color": "#4a90e2",
              "margin-bottom": "22px",
              "a": {
                "font-weight": "inherit",
                "pointer-events": "none"
              }
            },
            ".mbr-text": {
              "color": "#C4CFDE",
              "margin-bottom": "20px",
              "padding-right": "16%",
              "@media (max-width: 991px)": {
                "padding-right": "0"
              }
            },
            ".mbr-section-btn": {
              "margin-top": "20px"
            },
            ".social-container": {
              "width": "100%",
              "padding-top": "100px",
              "@media (max-width: 991px)": {
                "padding-top": "40px"
              }
            },
            ".social-title": {
              "color": "#f55e4a",
              "margin-bottom": "20px"
            },
            ".social-list": {
              "display": "flex",
              "align-items": "center",
              "flex-wrap": "wrap",
              "margin": "-10px -12px"
            },
            ".soc-item": {
              "display": "flex",
              "align-items": "center",
              "justify-content": "center",
              "position": "relative",
              "margin": "10px 12px",
              "min-width": "60px",
              "padding": "10px",
              "aspect-ratio": "(1 / 1)",
              "border-radius": "6px",
              "background": "linear-gradient(145deg, @socialBgColor1, @socialBgColor2)",
              "& when (@socialShadow)": {
                "box-shadow": "10px 10px 19px @socialShadow1, -10px -10px 19px @socialShadow2"
              },
              "transition": "0.4s all",
              "&:before": {
                "content": "\"\"",
                "position": "absolute",
                "top": "0",
                "left": "0",
                "z-index": "4",
                "transition": "0.4s all",
                "width": "100%",
                "height": "100%",
                "border-radius": "5px",
                "background": "linear-gradient(to right bottom, #212428, #16181c)",
                "opacity": "0"
              },
              ".mbr-iconfont": {
                "position": "relative",
                "z-index": "5",
                "transition": "0.4s all",
                "font-size": "22px",
                "color": "@socialColor"
              },
              "&:hover": {
                "transform": "translateY(-3px)",
                "&:before": {
                  "opacity": "1"
                }
              },
              "a": {
                "animation": "none"
              }
            },
            ".img-wrapper": {
              "padding": "15px",
              "border-radius": "6px",
              "position": "relative",
              "width": "100%",
              "& when (@imgBg)": {
                "background": "linear-gradient(to right, @cardBg1, @cardBg2)"
              },
              "& when (@cardShadow)": {
                "box-shadow": "10px 10px 19px @shadowColor1, -10px -10px 19px @shadowColor2"
              }
            },
            ".img-box": {
              "width": "100%",
              "border-radius": "6px",
              "overflow": "hidden",
              "img": {
                "width": "100%",
                "object-fit": "cover",
                "aspect-ratio": "(700 / 933)"
              }
            },
            ".mbr-text, .mbr-section-btn": {
              "color": "#2d2d2d"
            }
          },
          "_cid": "uSwzeVsVBv",
          "_anchor": "aheader8-z",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "_name": "afeatures11",
          "_sourceTheme": "expertm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"features11 expertm5\" group=\"Features\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"5\">\n        <select title=\"Align\" name=\"contentAlign\">\n            <option value=\"justify-content-start\" selected>Left</option>\n            <option value=\"justify-content-center\">Center</option>\n            <option value=\"justify-content-end\">Right</option>\n        </select>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showMainTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showMainSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Lines Title\" name=\"showCardsTitle\" checked>\n        <input type=\"checkbox\" title=\"Lines Subtitle\" name=\"showCardsSubtitle\" checked>\n        <input type=\"checkbox\" title=\"Lines Text\" name=\"showLinesText\" checked>\n        <input type=\"range\" inline title=\"List Count\" name=\"listCount\" min=\"1\" max=\"2\" step=\"1\" value=\"2\">\n        <select title=\"Lines 1\" name=\"cardsAmount1\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n        </select>\n        <select title=\"Lines 2\" name=\"cardsAmount2\" condition=\"listCount >1\">\n            <option value=\"1\">1</option>\n            <option value=\"2\">2</option>\n            <option value=\"3\">3</option>\n            <option value=\"4\">4</option>\n            <option value=\"5\" selected>5</option>\n        </select>\n        <header>Lines 1</header>\n        <input type=\"range\" inline title=\"Line Active 1\" name=\"line1Active1\" min=\"0\" max=\"100\" step=\"1\" value=\"95\">\n        <input type=\"range\" inline title=\"Line Active 2\" name=\"line1Active2\" min=\"0\" max=\"100\" step=\"1\" value=\"70\" condition=\"cardsAmount1 >1\">\n        <input type=\"range\" inline title=\"Line Active 3\" name=\"line1Active3\" min=\"0\" max=\"100\" step=\"1\" value=\"78\" condition=\"cardsAmount1 >2\">\n        <input type=\"range\" inline title=\"Line Active 4\" name=\"line1Active4\" min=\"0\" max=\"100\" step=\"1\" value=\"73\" condition=\"cardsAmount1 >3\">\n        <input type=\"range\" inline title=\"Line Active 5\" name=\"line1Active5\" min=\"0\" max=\"100\" step=\"1\" value=\"92\" condition=\"cardsAmount1 >4\">\n        <header condition=\"listCount >1\">Lines 2</header>\n        <input type=\"range\" inline title=\"Line Active 1\" name=\"line2Active1\" min=\"0\" max=\"100\" step=\"1\" value=\"94\" condition=\"listCount >1\">\n        <input type=\"range\" inline title=\"Line Active 2\" name=\"line2Active2\" min=\"0\" max=\"100\" step=\"1\" value=\"88\" condition=\"cardsAmount2 >1 &amp;&amp; listCount >1\">\n        <input type=\"range\" inline title=\"Line Active 3\" name=\"line2Active3\" min=\"0\" max=\"100\" step=\"1\" value=\"98\" condition=\"cardsAmount2 >2 &amp;&amp; listCount >1\">\n        <input type=\"range\" inline title=\"Line Active 4\" name=\"line2Active4\" min=\"0\" max=\"100\" step=\"1\" value=\"99\" condition=\"cardsAmount2 >3 &amp;&amp; listCount >1\">\n        <input type=\"range\" inline title=\"Line Active 5\" name=\"line2Active5\" min=\"0\" max=\"100\" step=\"1\" value=\"100\" condition=\"cardsAmount2 >4 &amp;&amp; listCount >1\">\n        <header>Lines Style</header>\n        <input type=\"color\" title=\"Lines Text Color\" name=\"linesTextColor\" value=\"#f55e4a\">\n        <input type=\"color\" title=\"Lines BG\" name=\"linesBg\" value=\"#212428\">\n        <input type=\"color\" title=\"Lines Active BG 1\" name=\"linesBg1\" value=\"#4a90e2\">\n        <input type=\"color\" title=\"Lines Active BG 2\" name=\"linesBg2\" value=\"#f55e4a\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\">\n            <input type=\"image\" title=\"Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#fafafa\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"@ADDONS_PATH@/expertm5/components/_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#212428\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n    </div>\n\n\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row\">\n            <div class=\"col-12\" mbr-if=\"showMainTitle || showMainSubtitle\">\n                <div class=\"mbr-section-head\">\n                    <h3 class=\"mbr-section-title mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showMainTitle\" data-app-selector=\".mbr-section-title\">\n                        9+ YEARS OF EXPERIENCE\n                    </h3>\n                    <h5 class=\"mbr-section-subtitle mbr-fonts-style align-center mb-0\" mbr-theme-style=\"display-2\" mbr-if=\"showMainSubtitle\" data-app-selector=\".mbr-section-subtitle\">\n                       <b>My Resume</b>\n                    </h5>\n                </div>\n            </div>\n        </div>\n        <div class=\"row card-row {{contentAlign}}\">\n            <div class=\"cards-container cards-container-1 col-12 col-md-6\">\n                <div class=\"cards-head\" mbr-if=\"showCardsTitle || showCardsSubtitle\">\n                    <h3 class=\"cards-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardsTitle\" data-app-selector=\".cards-title\">\n                        Features\n                    </h3>\n                    <h5 class=\"cards-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showCardsSubtitle\" data-app-selector=\".cards-subtitle\">\n                        <b>Design Skill</b>\n                    </h5>\n                </div>\n                <div class=\"cards-list\">\n                    <div class=\"lines-wrap\">\n                        <div class=\"line-item-container\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                PHOTOSHOT\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line1-item-active-1\">\n                                    <span class=\"percent-text percent-text1\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount1 >1\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                FIGMA\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line1-item-active-2\">\n                                    <span class=\"percent-text percent-text2\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount1 >2\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                ADOBE XD.\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line1-item-active-3\">\n                                    <span class=\"percent-text percent-text3\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount1 >3\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                ADOBE ILLUSTRATOR\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line1-item-active-4\">\n                                    <span class=\"percent-text percent-text4\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount1 >4\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                DESIGN\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line1-item-active-5\">\n                                    <span class=\"percent-text percent-text5\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n            <div class=\"cards-container cards-container-2 col-12 col-md-6\" mbr-if=\"listCount > 1\">\n                <div class=\"cards-head\" mbr-if=\"showCardsTitle || showCardsSubtitle\">\n                    <h3 class=\"cards-title mbr-fonts-style mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showCardsTitle\" data-app-selector=\".cards-title\">\n                        Features\n                    </h3>\n                    <h5 class=\"cards-subtitle mbr-fonts-style mb-0\" mbr-theme-style=\"display-5\" mbr-if=\"showCardsSubtitle\" data-app-selector=\".cards-subtitle\">\n                        <b>Development Skill</b>\n                    </h5>\n                </div>\n                <div class=\"cards-list\">\n                    <div class=\"lines-wrap\">\n                        <div class=\"line-item-container\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                PLUGIN\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line2-item-active-1\">\n                                    <span class=\"percent-text percent-text1\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount2 >1\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                SOFTWARE\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line2-item-active-2\">\n                                    <span class=\"percent-text percent-text2\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount2 >2\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                JAVASCRIPT\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line2-item-active-3\">\n                                    <span class=\"percent-text percent-text3\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount2 >3\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                CSS\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line2-item-active-4\">\n                                    <span class=\"percent-text percent-text4\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                        <div class=\"line-item-container\" mbr-if=\"cardsAmount2 >4\">\n                            <p class=\"line-text mbr-fonts-style\" mbr-theme-style=\"display-7\" mbr-if=\"showLinesText\" data-app-selector=\".line-text\">\n                                HTML\n                            </p>\n                            <div class=\"line-item\">\n                                <div class=\"line-item-active line2-item-active-5\">\n                                    <span class=\"percent-text percent-text5\">%</span>\n                                </div>\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n\n        </div>\n    </div>\n</section>",
