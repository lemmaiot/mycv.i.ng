              "opacity": "0.75",
              "transition": "border-radius 0.8s, opacity 0.6s, box-shadow 0.4s",
              "& when (@cardBg)": {
                "background-color": "@cardsBgColor"
              },
              "& when (@cardBorder)": {
                "border": "1px solid @cardBorderColor"
              },
              "@media (max-width: 1199px) and (min-width: 767px)": {
                "padding": "24px"
              },
              "@media (max-width: 767px)": {
                "padding": "6.4vw",
                "min-height": "96vw",
                "border-radius": "6.4vw",
                "opacity": "1"
              },
              "&:hover": {
                "opacity": "1",
                "border-radius": "2.8vw",
                "& when (@cardBorder)": {
                  "box-shadow": "inset 0 0 0 1px @cardBorderColor"
                }
              }
            },
            ".item-head": {
              "display": "flex",
              "align-items": "flex-start",
              "width": "100%",
